---
// Brief §5 /compare — Move #5. Four side-by-side comparisons.
interface Comparison {
  them: { label: string; points: string[] };
  us: { points: string[] };
}

interface Props {
  title: string;
  comparison: Comparison;
}
const { title, comparison } = Astro.props;
---

<div class="rounded overflow-hidden border border-cream-deep">
  <div class="px-6 py-4 bg-cream-deep border-b border-cream-deep">
    <h3 class="font-sans font-medium text-sm text-navy">{title}</h3>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x" style="border-color: #d8d0a8;">
    <!-- Them -->
    <div class="p-6 bg-cream">
      <p class="text-xs font-medium tracking-widest uppercase text-navy-muted mb-4">{comparison.them.label}</p>
      <ul class="flex flex-col gap-3">
        {comparison.them.points.map((p) => (
          <li class="flex items-start gap-2.5 text-sm text-navy-muted">
            <span class="mt-1 shrink-0 w-3.5 h-3.5 rounded-full border border-navy-muted flex items-center justify-center opacity-40" aria-hidden="true">
              <svg width="6" height="6" viewBox="0 0 6 6"><line x1="1" y1="3" x2="5" y2="3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </span>
            {p}
          </li>
        ))}
      </ul>
    </div>
    <!-- Us -->
    <div class="p-6 bg-cream">
      <p class="text-xs font-medium tracking-widest uppercase text-coral mb-4">StaaS</p>
      <ul class="flex flex-col gap-3">
        {comparison.us.points.map((p) => (
          <li class="flex items-start gap-2.5 text-sm text-navy">
            <span class="mt-1 shrink-0 w-3.5 h-3.5 rounded-full border border-coral flex items-center justify-center" aria-hidden="true">
              <svg width="6" height="6" viewBox="0 0 6 6"><polyline points="1,3 2.5,4.5 5,1.5" stroke="#E34C39" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
            </span>
            {p}
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>
