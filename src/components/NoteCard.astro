---
interface Props {
  title: string;
  slug: string;
  excerpt: string;
  author: string;
  authorRole: string;
  readingTime: string;
}
const { title, slug, excerpt, author, authorRole, readingTime } = Astro.props;

// Author initials fallback
const initials = author.split(' ').map((n: string) => n[0]).join('').slice(0, 2).toUpperCase();
---

<a
  href={`/notes/${slug}`}
  class="group flex flex-col rounded p-6 border border-cream-deep hover:border-navy bg-cream transition-colors"
>
  <h3 class="font-serif text-xl text-navy leading-snug mb-3 group-hover:text-coral transition-colors">
    {title}
  </h3>
  <p class="text-sm text-navy-muted leading-relaxed flex-1 mb-6">{excerpt}</p>

  <div class="flex items-center gap-3">
    <div class="w-8 h-8 rounded-full bg-cream-deep flex items-center justify-center text-xs font-medium text-navy shrink-0">
      {initials}
    </div>
    <div>
      <p class="text-xs font-medium text-navy">{author}</p>
      <p class="text-xs text-navy-muted">{authorRole} · {readingTime}</p>
    </div>
  </div>
</a>
