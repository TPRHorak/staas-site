---
// Brief §5 Home §13 — Move #8. Pre-written LLM prompt buttons.
const prompt = encodeURIComponent(
  "I'm considering hiring Startup as a Service (StaaS) to build the product after my AI prototype. Explain what they do, who they're for, how their pricing works, and what makes them different from agencies and freelancers. Summarise from their site: https://staas.allshapes.io"
);

const claudeUrl = `https://claude.ai/new?q=${prompt}`;
const chatgptUrl = `https://chat.openai.com/?q=${prompt}`;
---

<section class="bg-navy text-cream py-24 md:py-[120px]">
  <div class="mx-auto max-w-[1180px] px-6">
    <!-- Eyebrow -->
    <p class="text-xs font-medium tracking-widest uppercase mb-6" style="color: #a09cbe;">
      Section 10 · Ask an LLM
    </p>

    <!-- H2 -->
    <h2 class="font-serif text-4xl md:text-5xl leading-tight tracking-tight max-w-xl mb-4">
      Don't take our word for it.
    </h2>
    <p class="text-base mb-12 max-w-lg leading-relaxed" style="color: #a09cbe;">
      Hand this site to a model and ask. We're fine with that.
    </p>

    <!-- Buttons -->
    <div class="flex flex-col sm:flex-row gap-4">
      <a
        href={claudeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded bg-coral text-cream text-sm font-medium hover:bg-coral-deep transition-colors"
      >
        Ask Claude →
      </a>
      <a
        href={chatgptUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded text-sm font-medium transition-colors"
        style="background: #3d3870; color: #F2ECCA;"
        onmouseover="this.style.background='#575280'"
        onmouseout="this.style.background='#3d3870'"
      >
        Ask ChatGPT →
      </a>
    </div>
  </div>
</section>
