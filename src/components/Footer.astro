---
const year = new Date().getFullYear();

const navLinks = [
  { label: "Home", href: "/" },
  { label: "Compare", href: "/compare" },
  { label: "Work", href: "/work" },
  { label: "Notes", href: "/notes" },
  { label: "Sprint", href: "/sprint" },
  { label: "Book a Sprint", href: "/book" },
];

const directLinks = [
  { label: "workshop@allshapes.io", href: "mailto:workshop@allshapes.io" },
  { label: "LinkedIn", href: "https://www.linkedin.com/company/allshapesio", external: true },
  { label: "Twitter / X", href: "https://x.com/allshapesio", external: true },
  { label: "Privacy Policy", href: "https://allshapes.io/privacy-policy", external: true },
  { label: "Terms of Service", href: "https://allshapes.io/terms-of-service", external: true },
  { label: "Cookie Policy", href: "https://allshapes.io/cookie-policy", external: true },
  { label: "Imprint", href: "https://allshapes.io/imprint", external: true },
];
---

<footer class="bg-navy text-cream">
  <div class="mx-auto max-w-[1180px] px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">

      <!-- Brand -->
      <div class="flex flex-col gap-4">
        <a href="/" class="font-serif text-xl text-cream tracking-tight">ALL SHAPES®</a>
        <p class="text-sm leading-relaxed" style="color: #a09cbe;">
          UK and Europe-based.<br />We do not offshore.
        </p>
        <p class="text-sm" style="color: #a09cbe;">© {year} ALL SHAPES®. All rights reserved.</p>
      </div>

      <!-- Nav -->
      <nav class="flex flex-col gap-3">
        <span class="text-xs font-medium tracking-widest uppercase mb-1" style="color: #a09cbe;">Pages</span>
        {navLinks.map((link) => (
          <a href={link.href} class="text-sm text-cream hover:text-yellow transition-colors">{link.label}</a>
        ))}
      </nav>

      <!-- Direct -->
      <div class="flex flex-col gap-3">
        <span class="text-xs font-medium tracking-widest uppercase mb-1" style="color: #a09cbe;">Direct</span>
        {directLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm text-cream hover:text-yellow transition-colors"
            {...link.external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
          >
            {link.label}
          </a>
        ))}
      </div>

    </div>
  </div>
</footer>
