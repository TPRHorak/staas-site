---
// Deck Section 04 — After the Sprint, three ways to engage
const tiers = [
  {
    name: "Launch",
    price: "€12,500",
    period: "/ month",
    tag: null,
    subtitle: "Single-user products",
    description: "Apps, tools, subscription products.",
    includes: [
      "18 build points / month",
      "Senior product + engineering",
      "Maintenance during quiet phases",
      "3-month minimum, pause up to 60 days",
    ],
  },
  {
    name: "Scale",
    price: "€19,500",
    period: "/ month",
    tag: "Most common",
    subtitle: "B2B, marketplaces, shared data",
    description: "Coaching platforms, multi-tenant SaaS.",
    includes: [
      "36 build points / month",
      "Multi-tenant architecture work",
      "Permission, data, role design",
      "6-month minimum",
    ],
  },
  {
    name: "Embed",
    price: "€17.5–25.5k",
    period: "/ month, on top of base tier",
    tag: null,
    subtitle: "Strategic time, embedded",
    description: "Tom or Callum as part of your founding team.",
    includes: [
      "Everything in base tiers",
      "Strategic product decisions",
      "Investor + sales support",
      "6-month minimum",
    ],
  },
];
---

<section id="pricing" class="bg-cream-deep py-24 md:py-[120px]">
  <div class="mx-auto max-w-[1180px] px-6">

    <p class="text-xs font-medium tracking-widest uppercase text-coral mb-8">After the Sprint</p>

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-6">
      <h2 class="font-serif text-5xl md:text-6xl text-navy leading-tight tracking-tight max-w-lg">
        Three ways to engage.
      </h2>
      <p class="text-sm text-navy-muted md:text-right shrink-0">
        Subscription tiers. Pause anytime. No equity.
      </p>
    </div>

    <div class="mb-16 h-px" style="background: #d8d0a8;"></div>

    <!-- Tier cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {tiers.map((tier) => (
        <div class:list={[
          "relative flex flex-col rounded p-8 border",
          tier.tag ? "border-navy bg-navy text-cream" : "border-cream bg-cream"
        ]}>
          {tier.tag && (
            <span class="absolute -top-3 left-6 px-3 py-1 bg-coral text-cream text-xs font-medium rounded tracking-wide">
              {tier.tag}
            </span>
          )}

          <p class:list={["text-xs font-medium tracking-widest uppercase mb-4", tier.tag ? "opacity-60" : "text-navy-muted"]}>{tier.name}</p>

          <div class="mb-1">
            <span class:list={["font-serif text-5xl", tier.tag ? "text-cream" : "text-navy"]}>{tier.price}</span>
          </div>
          <p class:list={["text-xs mb-8", tier.tag ? "opacity-60" : "text-navy-muted"]}>{tier.period}</p>

          <p class:list={["text-sm font-medium mb-1", tier.tag ? "text-cream" : "text-navy"]}>{tier.subtitle}</p>
          <p class:list={["text-sm mb-8 leading-relaxed", tier.tag ? "opacity-70" : "text-navy-muted"]}>{tier.description}</p>

          <ul class="flex flex-col gap-3 mb-10 flex-1">
            {tier.includes.map((item) => (
              <li class:list={["flex items-start gap-2 text-sm", tier.tag ? "text-cream opacity-80" : "text-navy-muted"]}>
                <span class="mt-1 shrink-0 w-3.5 h-3.5 rounded-full border border-coral flex items-center justify-center">
                  <span class="w-1.5 h-1.5 rounded-full bg-coral block"></span>
                </span>
                {item}
              </li>
            ))}
          </ul>

          <a
            href="/sprint"
            class:list={[
              "mt-auto inline-flex items-center justify-center px-5 py-3 rounded text-sm font-medium transition-colors",
              tier.tag
                ? "bg-coral text-cream hover:bg-coral-deep"
                : "bg-navy text-cream hover:bg-navy-deep"
            ]}
          >
            Book the sprint
          </a>
        </div>
      ))}
    </div>

    <!-- Bottom lines -->
    <div class="mt-12 flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-t pt-10" style="border-color: #d8d0a8;">
      <p class="font-serif text-xl text-navy">Same team, for years. Continuity is the product.</p>
      <p class="text-sm text-navy-muted">
        <s class="opacity-50">Sprint €6,250</s>
        {" "}→{" "}
        <strong class="text-navy font-medium">full credit toward month 1 if you sign within 14 days.</strong>
      </p>
    </div>
  </div>
</section>
