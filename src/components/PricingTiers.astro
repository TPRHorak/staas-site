---
const tiers = [
  {
    name: "Launch",
    price: "€12,500",
    period: "/ month",
    tag: null,
    subtitle: "Single-user products",
    description: "Apps, tools, subscription products.",
    includes: [
      "18 build points / month",
      "Senior product + engineering",
      "Maintenance during quiet phases",
      "3-month minimum, pause up to 60 days",
    ],
  },
  {
    name: "Scale",
    price: "€19,500",
    period: "/ month",
    tag: "Most common",
    subtitle: "B2B, marketplaces, shared data",
    description: "Coaching platforms, multi-tenant SaaS.",
    includes: [
      "36 build points / month",
      "Multi-tenant architecture work",
      "Permission, data, role design",
      "6-month minimum",
    ],
  },
  {
    name: "Embed",
    price: "€17.5–25.5k",
    period: "/ month, on top of base tier",
    tag: null,
    subtitle: "Strategic time, embedded",
    description: "Tom or Callum as part of your founding team.",
    includes: [
      "Everything in base tiers",
      "Strategic product decisions",
      "Investor + sales support",
      "6-month minimum",
    ],
  },
];
---

<section id="pricing" class="bg-cream py-24 md:py-[120px]">
  <div class="mx-auto max-w-[1180px] px-6">

    <p class="font-mono text-xs text-coral mb-10 tracking-wider">// after_the_sprint</p>

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-6">
      <h2 class="font-serif text-5xl md:text-6xl text-navy leading-tight tracking-tight max-w-lg">
        Three ways to engage.
      </h2>
      <p class="text-sm text-navy-muted md:text-right shrink-0">
        Subscription tiers. Pause anytime. No equity.
      </p>
    </div>

    <div class="mb-16 h-px" style="background: #d8d0a8;"></div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-px rounded overflow-hidden" style="background: #d8d0a8;">
      {tiers.map((tier) => (
        <div class:list={[
          "relative flex flex-col p-8 md:p-10",
          tier.tag ? "bg-navy text-cream" : "bg-cream"
        ]}>
          {tier.tag && (
            <span class="absolute top-8 right-8 px-2 py-1 bg-coral text-cream text-xs font-mono rounded-sm">
              {tier.tag}
            </span>
          )}

          <p class="font-mono text-xs mb-6" style={tier.tag ? "color: #a09cbe;" : "color: #b8b2d8;"}>{tier.name}</p>

          <div class="mb-6">
            <span class:list={["font-serif text-5xl md:text-6xl", tier.tag ? "text-cream" : "text-navy"]}>{tier.price}</span>
            <p class:list={["font-mono text-xs mt-2", tier.tag ? "opacity-50" : "text-navy-muted"]}>{tier.period}</p>
          </div>

          <p class:list={["text-sm font-medium mb-1", tier.tag ? "text-cream" : "text-navy"]}>{tier.subtitle}</p>
          <p class:list={["text-sm mb-8 leading-relaxed", tier.tag ? "opacity-60" : "text-navy-muted"]}>{tier.description}</p>

          <ul class="flex flex-col gap-3 mb-10 flex-1">
            {tier.includes.map((item) => (
              <li class:list={["flex items-start gap-3 text-sm leading-relaxed", tier.tag ? "opacity-80" : "text-navy-muted"]}>
                <span class="text-coral shrink-0 mt-0.5">→</span>
                {item}
              </li>
            ))}
          </ul>

          <a href="/sprint"
            class:list={[
              "mt-auto inline-flex items-center justify-center px-5 py-3 rounded-sm text-sm font-medium transition-colors",
              tier.tag
                ? "bg-coral text-cream hover:bg-coral-deep"
                : "bg-navy text-cream hover:bg-navy-deep"
            ]}>
            Book the sprint
          </a>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-t pt-8" style="border-color: #d8d0a8;">
      <p class="font-serif text-xl text-navy">Same team, for years. Continuity is the product.</p>
      <p class="font-mono text-xs text-navy-muted">
        <s class="opacity-40">Sprint €6,250</s> → full credit toward month 1 if you sign within 14 days.
      </p>
    </div>
  </div>
</section>
