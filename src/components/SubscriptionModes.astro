---
// Deck Section 05 — "What we deliver"
const services = [
  {
    tag: "What to build",
    title: "Product strategy.",
    body: "User research, scope, roadmap. Right-sizing calls — what to build, what to leave.",
  },
  {
    tag: "How it looks",
    title: "Design & UX.",
    body: "UX flows, UI design, design systems. The taste that earns Apple editorial.",
  },
  {
    tag: "How it works",
    title: "Engineering.",
    body: "Cross-platform: iOS, Android, web. Secure backend. AI when it earns its place.",
  },
  {
    tag: "How it lives",
    title: "Launch & operate.",
    body: "Launch strategy, App Store editorial, beta testing, ongoing maintenance.",
  },
];
---

<section class="bg-cream py-24 md:py-[120px]">
  <div class="mx-auto max-w-[1180px] px-6">

    <p class="text-xs font-medium tracking-widest uppercase text-coral mb-8">What we deliver</p>

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-20">
      <h2 class="font-serif text-5xl md:text-6xl lg:text-7xl text-navy leading-[1.0] tracking-tight max-w-2xl">
        One team. The full service of building software products.
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-px rounded overflow-hidden" style="background: #d8d0a8;">
      {services.map((s, i) => (
        <div class={`p-8 md:p-12 flex flex-col gap-4 ${i % 2 === 0 ? 'bg-cream' : 'bg-cream-deep'}`}>
          <span class="text-xs font-medium tracking-widest uppercase text-coral">{s.tag}</span>
          <h3 class="font-serif text-4xl md:text-5xl text-navy leading-tight">{s.title}</h3>
          <p class="text-sm text-navy-muted leading-relaxed max-w-xs">{s.body}</p>
        </div>
      ))}
    </div>

    <p class="mt-16 font-serif text-2xl md:text-3xl text-navy-muted leading-snug">
      You hire one team. They flex with the product.{" "}
      <span class="text-navy">No re-staffing when the work changes shape.</span>
    </p>
  </div>
</section>
