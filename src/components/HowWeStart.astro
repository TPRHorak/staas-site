---
const steps = [
  {
    n: "01",
    title: "Start with a Sprint.",
    sub: "Two weeks. €6,250. One real outcome.",
    bullets: [
      "Map your goals, your users, and the biggest risk in the plan.",
      "Leave with working software, or a tested prototype with a buildable plan.",
    ],
    note: "Full credit toward month 1 if you continue within 14 days.",
  },
  {
    n: "02",
    title: "Onboard in a week.",
    sub: "No ramp-up theatre.",
    bullets: [
      "Senior team across your codebase and Sprint findings by day three.",
      "First proper sprint scoped, debt flagged, priorities set.",
    ],
    note: "The Sprint was the discovery. We build from there.",
  },
  {
    n: "03",
    title: "Ship every two weeks.",
    sub: "Working software, in your Slack.",
    bullets: [
      "End-to-end features on a two-week cadence.",
      "Shared Slack with the senior team — no status meetings.",
      "Full release cycle: beta, App Store, production.",
    ],
    note: "Most teams spend 90 days on a discovery doc. We ship in that time.",
  },
  {
    n: "04",
    title: "Learn and plan what's next.",
    sub: "Every cycle is smarter than the last.",
    bullets: [
      "Next sprint planned against what users actually do, not what we assumed.",
      "Same team on your product, for years.",
    ],
    note: "We don't disappear after launch. That's when the work starts.",
  },
];
---

<section id="how-it-works" class="py-24 md:py-[120px]" style="background: #1F1B4A;">
  <div class="mx-auto max-w-[1180px] px-6">

    <p class="text-xs uppercase tracking-[0.18em] text-coral mb-6 md:mb-8">How it works</p>

    <div class="flex flex-col md:flex-row md:items-end gap-6 mb-12">
      <h2 class="font-serif text-5xl md:text-6xl lg:text-7xl text-cream leading-[1.2] tracking-tight max-w-2xl">
        The in-house team that isn't in-house.
      </h2>
      <p class="text-base max-w-sm leading-relaxed md:ml-auto md:text-right shrink-0" style="color: #a09cbe;">
        Four steps. No surprises. Here's what we do and when.
      </p>
    </div>

    <p class="font-serif text-xl md:text-2xl leading-snug mb-20 max-w-3xl" style="color: #d8d2ee;">
      Onboarded on Day 1. No discovery quarter. We've done this for dozens of startups, so getting started feels less like hiring an agency and more like switching on a team you've worked with for years. We look at your mess, carve out the first two weeks, and get going.
    </p>

    <!-- 2×2 card grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-px rounded overflow-hidden" style="background: #3d3870;">
      {steps.map((step) => (
        <div class="p-8 md:p-10 flex flex-col gap-6" style="background: #2B2660;">
          <!-- Step number + title -->
          <div class="flex items-start gap-5">
            <span class="font-serif text-5xl text-coral leading-none shrink-0">{step.n}</span>
            <div>
              <p class="font-serif text-xl text-cream leading-snug">{step.title}</p>
              <p class="text-sm mt-1.5" style="color: #a09cbe;">{step.sub}</p>
            </div>
          </div>
          <!-- Bullets -->
          <ul class="flex-1 flex flex-col gap-3 border-t border-b py-6" style="border-color: #3d3870;">
            {step.bullets.map((b) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed" style="color: #a09cbe;">
                <span class="text-coral mt-0.5 shrink-0" aria-hidden="true">→</span>
                {b}
              </li>
            ))}
          </ul>
          <!-- Note -->
          <p class="text-sm leading-relaxed" style="color: #8c87b0;">{step.note}</p>
        </div>
      ))}
    </div>

    <p class="mt-16 font-serif text-2xl md:text-3xl leading-snug max-w-3xl text-cream">
      No status meetings.<br/>
      <span style="color: #a09cbe;">We're in your Slack, building alongside you.</span>
    </p>

    <div class="mt-12 flex flex-col sm:flex-row gap-4">
      <a href="/book"
        class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm bg-coral text-cream text-sm font-medium hover:bg-coral-deep transition-colors">
        Book a Sprint →
      </a>
      <a href="mailto:workshop@allshapes.io?subject=Hello%20from%20startupasaservice.co"
        class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm text-sm font-medium transition-colors"
        style="border: 1px solid #3d3870; color: #cfcae5;">
        Get in touch
      </a>
    </div>
  </div>
</section>
