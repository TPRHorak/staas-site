---
const testimonials = [
  {
    quote: "An advisor was helping me decide which agency to work with. With all the companies he reviewed, there were always pros and cons. Except All Shapes.",
    name: "Akash Vaghela",
    role: "Founder, RNT Fitness",
    initials: "AV",
    photo: "https://allshapes.io/assets/images/temp/testimonial-rnt.jpg",
  },
  {
    quote: "Your company rules. I often feel dazed from chasing vendors to hold up their end. All Shapes has been a breath of fresh air since day one.",
    name: "Brandon Leichter",
    role: "Owner, Allen's Camera",
    initials: "BL",
    photo: "https://allshapes.io/assets/images/temp/testimonial-acs.jpg",
  },
  {
    quote: "When we started talking, you could feel the attention to detail and that the team really understands the industry and what we as a company are about.",
    name: "Chandni Vaghela",
    role: "Co-founder, RNT Fitness",
    initials: "CV",
    photo: null,
  },
];
---

<section class="py-20 md:py-24" style="background: #ECE4B8;">
  <div class="mx-auto max-w-[1180px] px-6 mb-10">
    <p class="text-xs uppercase tracking-[0.18em] text-coral mb-6 md:mb-8">From Founders</p>
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <h2 class="font-serif text-5xl md:text-6xl text-navy leading-[1.15] tracking-tight max-w-lg">
        What they said.
      </h2>
      <p class="hidden md:block text-xs uppercase tracking-widest text-navy-muted shrink-0">
        Swipe to see more →
      </p>
    </div>
  </div>

  <!-- Horizontal scroll-snap carousel — bleeds to the viewport edge so
       the next card peeks in. Padding-left aligns the first card to the
       container; padding-right gives breathing room past the last card. -->
  <div
    class="testimonial-carousel overflow-x-auto pb-6 -mb-6"
    role="region"
    aria-label="Founder testimonials"
    tabindex="0"
  >
    <div class="testimonial-track flex gap-5 snap-x snap-mandatory pl-[max(1.5rem,calc((100vw-1180px)/2+1.5rem))] pr-[max(1.5rem,calc((100vw-1180px)/2+1.5rem))]">
      {testimonials.map((t) => (
        <figure class="testimonial-card snap-start shrink-0 w-[88%] sm:w-[460px] md:w-[460px] bg-cream rounded-xl p-7 md:p-8 flex flex-col gap-6" style="border: 1px solid #d8d0a8;">
          <blockquote class="font-serif text-lg md:text-xl leading-snug text-navy">
            "{t.quote}"
          </blockquote>
          <figcaption class="mt-auto flex items-center gap-3">
            {t.photo ? (
              <img src={t.photo} alt={t.name}
                class="w-12 h-12 rounded-full object-cover shrink-0"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
            ) : null}
            <div class:list={[
              "w-12 h-12 rounded-full items-center justify-center text-sm font-medium shrink-0 bg-cream-deep text-navy",
              t.photo ? "hidden" : "flex",
            ]}>
              {t.initials}
            </div>
            <div>
              <p class="text-sm font-medium text-navy">{t.name}</p>
              <p class="text-xs text-navy-muted mt-0.5">{t.role}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  /* Slim, branded scrollbar so the carousel reads as scrollable. */
  .testimonial-carousel {
    scrollbar-width: thin;
    scrollbar-color: #d8d0a8 transparent;
  }
  .testimonial-carousel::-webkit-scrollbar {
    height: 6px;
  }
  .testimonial-carousel::-webkit-scrollbar-track {
    background: transparent;
  }
  .testimonial-carousel::-webkit-scrollbar-thumb {
    background: #d8d0a8;
    border-radius: 3px;
  }
  .testimonial-carousel:focus-visible {
    outline: 2px solid #E34C39;
    outline-offset: 4px;
  }
</style>
