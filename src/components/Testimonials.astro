---
const testimonials = [
  {
    quote: "An advisor was helping me decide which agency to work with. I sent him information and proposals from a bunch of competitors. With all the companies he reviewed, there were always pros and cons for all of them. Except All Shapes.",
    name: "Akash Vaghela",
    role: "Founder, RNT Fitness",
    initials: "AV",
    photo: "https://allshapes.io/assets/images/temp/testimonial-rnt.jpg",
    metrics: ["Multi-platform", "Premium coaching SaaS", "Multi-tenant from day one"],
  },
  {
    quote: "Your company rules. I often feel dazed from days filled with chasing vendors to hold up their end of our partnership. All Shapes has been a breath of fresh air since day one.",
    name: "Brandon Leichter",
    role: "Owner, Allen's Camera",
    initials: "BL",
    photo: "https://allshapes.io/assets/images/temp/testimonial-acs.jpg",
    metrics: ["10× online revenue", "22% higher avg order value", "197% growth in carts"],
  },
  {
    quote: "When we started talking, you could feel the attention to detail and that the team really understands the industry and what we as a company are about. So you could sense it would be a really good collaboration.",
    name: "Chandni Vaghela",
    role: "Co-founder, RNT Fitness",
    initials: "CV",
    photo: null,
    metrics: ["Same team, build to maintenance", "In-house but not in-house"],
  },
];
---

<section class="bg-cream py-24 md:py-[120px]">
  <div class="mx-auto max-w-[1180px] px-6">

    <p class="font-mono text-xs text-coral mb-10 tracking-wider">// from_founders</p>

    <h2 class="font-serif text-5xl md:text-6xl text-navy leading-tight tracking-tight max-w-lg mb-16">
      What they said.
    </h2>

    <div class="flex flex-col gap-px rounded overflow-hidden" style="background: #d8d0a8;">
      {testimonials.map((t) => (
        <div class="grid grid-cols-1 md:grid-cols-4 gap-0 bg-cream">
          <!-- Avatar col -->
          <div class="p-8 md:p-10 md:border-r flex flex-col gap-4" style="border-color: #d8d0a8;">
            {t.photo ? (
              <img src={t.photo} alt={t.name}
                class="w-14 h-14 rounded-full object-cover"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
            ) : null}
            <div class:list={[
              "w-14 h-14 rounded-full items-center justify-center text-sm font-medium shrink-0 bg-cream-deep text-navy",
              t.photo ? "hidden" : "flex",
            ]}>
              {t.initials}
            </div>
            <div>
              <p class="text-sm font-medium text-navy">{t.name}</p>
              <p class="font-mono text-xs mt-1 text-navy-muted">{t.role}</p>
            </div>
          </div>
          <!-- Quote col -->
          <div class="px-8 pb-8 pt-0 md:p-10 md:col-span-3 flex flex-col justify-between gap-8">
            <blockquote class="font-serif text-xl md:text-2xl leading-snug text-navy">
              "{t.quote}"
            </blockquote>
            <div class="flex flex-wrap gap-2">
              {t.metrics.map((m) => (
                <span class="font-mono text-xs px-2 py-1 rounded-sm text-navy-muted" style="background: #ECE4B8;">
                  {m}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
