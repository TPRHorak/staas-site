---
// Compare page intro — uses the same rotating-word headline as the
// homepage’s WhyAllShapes section so the brand line stays consistent.
const rotatingWords = [
  "good",
  "secure",
  "intuitive",
  "scalable",
  "thoughtful",
  "efficient",
  "loved",
];

const columns = [
  {
    label: "Vibe-coded MVPs",
    body: "Demo on a weekend, fall apart in week six. Multi-tenant ceiling, security debt, and nobody who can tell you what to actually fix.",
  },
  {
    label: "Traditional agencies",
    body: "Still billing hours. Six months of discovery, rotating juniors, and a plateau the moment you’re out of retainer.",
  },
  {
    label: "Solo freelancers",
    body: "They write code, not strategy. Can’t advise on what to build. Continuity drifts the moment the project ends or they find something better.",
  },
];
---

<section class="text-cream py-24 md:py-[120px]" style="background: #2B2660;">
  <div class="mx-auto max-w-[1180px] px-6">

    <p class="text-xs uppercase tracking-[0.18em] text-coral mb-6 md:mb-8">The gap AI left</p>

    <h2 class="font-serif text-5xl md:text-6xl lg:text-7xl text-cream leading-[1.15] tracking-tight max-w-5xl mb-20">
      AI made building software cheap. It made
      <span class="word-rotator" data-words={JSON.stringify(rotatingWords)} aria-label="good, secure, intuitive, scalable, thoughtful, efficient, loved">
        <span class="word-rotator__current">good</span>
      </span>
      products rare.
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-px rounded overflow-hidden" style="background: #3d3870;">
      {columns.map((col) => (
        <div class="p-8 md:p-10 flex flex-col gap-4" style="background: #1F1B4A;">
          <div class="w-8 h-px bg-coral mb-2"></div>
          <h3 class="font-serif text-2xl text-cream">{col.label}</h3>
          <p class="text-sm leading-relaxed" style="color: #a09cbe;">{col.body}</p>
        </div>
      ))}
    </div>

    <p class="mt-16 font-serif text-2xl md:text-3xl leading-snug max-w-3xl" style="color: #a09cbe;">
      Most products built in 2026 will be forgotten inside a year.{" "}
      <span class="text-cream">The ones that last had someone behind them who cared about the right things.</span>
    </p>
  </div>
</section>

<style>
  /* Coral parallelogram chip. Reserved width = longest word + padding
     ("thoughtful" ≈ 4.45em) so the box never resizes and the line never
     reflows when the word swaps. The box is skewed; the text is
     counter-skewed so it stays upright. */
  .word-rotator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 5.1em;
    padding: 0.06em 0.32em;
    margin: 0 0.06em;
    vertical-align: baseline;
    background: var(--color-coral);
    color: #fff;
    border-radius: 6px;
    transform: skewX(-9deg);
    overflow: hidden;
    white-space: nowrap;
  }
  .word-rotator__current {
    display: inline-block;
    transform: skewX(9deg);
    transition: opacity 220ms ease, transform 320ms cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity, transform;
  }
  .word-rotator.is-leaving .word-rotator__current {
    opacity: 0;
    transform: skewX(9deg) translateY(-0.55em);
  }
  .word-rotator.is-entering .word-rotator__current {
    opacity: 0;
    transform: skewX(9deg) translateY(0.55em);
  }
  @media (prefers-reduced-motion: reduce) {
    .word-rotator__current { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('.word-rotator').forEach((root) => {
      if (root.dataset.rotatorBound === '1') return;
      root.dataset.rotatorBound = '1';
      let words = [];
      try { words = JSON.parse(root.dataset.words || '[]'); } catch (_) {}
      if (!Array.isArray(words) || words.length < 2) return;
      const cur = root.querySelector('.word-rotator__current');
      if (!cur) return;

      let i = 0;
      let paused = false;
      root.addEventListener('mouseenter', () => { paused = true; });
      root.addEventListener('mouseleave', () => { paused = false; });

      function tick() {
        if (paused) return;
        if (reduceMotion) {
          i = (i + 1) % words.length;
          cur.textContent = words[i];
          return;
        }
        root.classList.add('is-leaving');
        setTimeout(() => {
          i = (i + 1) % words.length;
          cur.textContent = words[i];
          root.classList.remove('is-leaving');
          root.classList.add('is-entering');
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              root.classList.remove('is-entering');
            });
          });
        }, 280);
      }

      // Don’t auto-cycle under prefers-reduced-motion — leave the first
      // word static rather than looping content changes.
      if (!reduceMotion) setInterval(tick, 2500);
    });
  })();
</script>
