---
// Brief §5 Home, section 4 — Slide-1 "The catch with AI" trio
const columns = [
  {
    title: "Vibe-coded MVPs",
    body: "Demo on a weekend. Fall apart in week six. Multi-tenant ceiling, security debt, no taste.",
  },
  {
    title: "Agencies",
    body: "Still selling hours. Six-month discoveries, rotating juniors, plateau after launch.",
  },
  {
    title: "Freelancers",
    body: "Ship code, not strategy. Can't tell you what to build. Continuity drifts the moment they're off the project.",
  },
];
---

<section class="relative overflow-hidden bg-navy text-cream py-24 md:py-[120px]">
  <!-- Decorative blob -->
  <div
    class="pointer-events-none absolute -bottom-20 -right-20 w-[360px] h-[360px] rounded-full opacity-20"
    style="background: #EC95C5; filter: blur(80px);"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-[1180px] px-6">
    <!-- Eyebrow -->
    <p class="text-xs font-medium tracking-widest uppercase mb-6" style="color: #a09cbe;">
      Section 01 · The catch with AI
    </p>

    <!-- H2 -->
    <h2 class="font-serif text-4xl md:text-5xl leading-tight tracking-tight max-w-2xl mb-16">
      AI made shipping software cheap. It made shipping the{" "}
      <em class="not-italic text-coral">right</em> software harder.
    </h2>

    <!-- Three columns -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 mb-16">
      {columns.map((col) => (
        <div class="border-t pt-6" style="border-color: #3d3870;">
          <h3 class="font-sans font-medium text-base mb-3 text-cream">{col.title}</h3>
          <p class="text-sm leading-relaxed" style="color: #a09cbe;">{col.body}</p>
        </div>
      ))}
    </div>

    <!-- Closing line -->
    <p class="text-base font-medium max-w-2xl leading-relaxed" style="color: #a09cbe;">
      Half the products launched in 2026 will be forgotten by Friday.{" "}
      <span class="text-cream">The ones that aren't will have a senior team behind them.</span>
    </p>
  </div>
</section>
