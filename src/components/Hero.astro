---
import { APPS, FEATURED_INDEX } from '../data/apps';
---

<section class="bg-navy-deep text-cream relative overflow-hidden">

  <!-- Subtle dot grid texture -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.035]"
    style="background-image: radial-gradient(#F2ECCA 1px, transparent 1px); background-size: 32px 32px;"
    aria-hidden="true"></div>

  <!-- Narrower container — only as wide as the text needs. -->
  <div class="relative mx-auto max-w-[920px] px-6 pt-32 pb-20 md:pt-40 md:pb-28">
    <div class="grid grid-cols-1 md:grid-cols-[1.4fr_1fr] gap-10 lg:gap-12 items-center">

      <!-- Left: copy -->
      <div class="relative z-10">

        <p class="text-xs uppercase tracking-[0.18em] mb-8" style="color: #cfcae5;">
          Startup as a Service · <span class="text-cream">by All Shapes</span>
        </p>

        <h1 class="font-serif text-5xl md:text-5xl lg:text-6xl text-cream leading-[1.05] tracking-tight mb-8">
          Customers don't meet your company. <span class="text-coral">They meet your product.</span>
        </h1>

        <p class="text-base leading-relaxed mb-4 max-w-md" style="color: #cfcae5;">
          We're the senior product and engineering team that builds it — end to end, in months not years.
        </p>

        <p class="text-base leading-relaxed mb-10 max-w-md" style="color: #a09cbe;">
          Behind Five Minute Journal (App of the Day, 60k MAU) and The Doctor's Kitchen (Apple Editorial, 4.8★).
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/book"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm bg-coral text-cream text-sm font-medium hover:bg-coral-deep transition-colors">
            Start with a Sprint →
          </a>
          <a href="mailto:workshop@allshapes.io?subject=Hello%20from%20startupasaservice.co"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm text-sm font-medium transition-colors"
            style="border: 1px solid #3d3870; color: #cfcae5;">
            Get in touch
          </a>
        </div>

        <p class="mt-10 text-sm leading-relaxed" style="color: #a09cbe;">
          Hosted by Thomas Horak — 15 years building startups,<br class="hidden md:block"/>
          and <a href="https://www.youtube.com/@ChangingShapesPodcast" target="_blank" rel="noopener noreferrer" class="text-cream hover:text-coral transition-colors underline-offset-2 hover:underline">a podcast full of the founders doing it now →</a>
        </p>
      </div>

      <!-- Right: small 2-row × 5-col app wall. The wall is taller than
           its container so the top row's top edge and the bottom row's
           bottom edge get clipped — implies more rows above and below
           without needing ghost tiles. -->
      <div class="app-wall" aria-hidden="true">
        <div class="app-wall__inner">
          <div class="grid grid-rows-2 grid-cols-5 gap-2">
            {APPS.map((app, i) => (
              <div class={`app-tile ${i === FEATURED_INDEX ? 'app-tile--featured' : ''}`}>
                <div class="block relative overflow-hidden rounded-lg" style="aspect-ratio: 1/1;">
                  <img
                    src={app.icon}
                    alt=""
                    class="absolute inset-0 w-full h-full object-cover"
                    loading={i === FEATURED_INDEX ? "eager" : "lazy"}
                  />
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .app-wall {
    /* Window. The inner grid is taller than this — top and bottom edges
       of the rows get clipped, so the wall reads as a frame onto a
       larger collection. No placeholders needed; the cut does it. */
    overflow: hidden;
    /* Slightly wider than the column to push the icons to a useful
       readable size; the section's overflow-hidden contains the spill. */
    width: 110%;
    margin-left: -5%;
  }

  .app-wall__inner {
    /* Pull the inner grid up so row 1's top edge slips past the
       container top, and let it overflow downward past the bottom too.
       Together these create the cut-at-top-and-bottom effect. */
    margin-top: -22px;
    margin-bottom: -22px;
  }

  .app-tile > div {
    background: #2B2660;
    border: 1px solid #3d3870;
    box-shadow: 0 6px 16px -10px rgba(0, 0, 0, 0.5);
  }

  /* Featured FMJ — soft coral ring as the anchor point. */
  .app-tile--featured > div {
    box-shadow: 0 8px 20px -10px rgba(227, 76, 57, 0.55),
                0 0 0 1.5px rgba(227, 76, 57, 0.5);
    border-color: rgba(227, 76, 57, 0.45);
  }

  /* ---- Mobile — keep the same 2x5 but uncrop so nothing's hidden. */
  @media (max-width: 768px) {
    .app-wall {
      width: 100%;
      max-width: 360px;
      margin: 0 auto;
    }
    .app-wall__inner {
      margin-top: 0;
      margin-bottom: 0;
    }
  }
</style>
