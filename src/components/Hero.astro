---
import { APPS } from '../data/apps';

// Two vertical columns of app icons — 5 tiles each. Each column is
// staggered so they don't line up horizontally; both are taller than
// the hero section so the top and bottom tiles get clipped by the
// section's overflow-hidden.
// Habits (APPS[1]) sits at the clipped top slot; The Doctor's Kitchen
// (APPS[0]) takes the second, fully-visible slot.
const colA = [APPS[1], APPS[0], APPS[2], APPS[3], APPS[4]];
const colB = [APPS[5], APPS[6], APPS[7], APPS[8], APPS[9]];
---

<section class="bg-navy-deep text-cream relative overflow-hidden">

  <!-- Subtle dot grid texture -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.035]"
    style="background-image: radial-gradient(#F2ECCA 1px, transparent 1px); background-size: 32px 32px;"
    aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[1180px] px-6 pt-32 pb-0 md:pt-40">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20 items-end relative">

      <!-- Left: copy -->
      <div class="pb-24 md:pb-32 relative z-30">

        <p class="text-xs uppercase tracking-[0.18em] mb-8" style="color: #cfcae5;">
          Startup as a Service · <span class="text-cream">by All Shapes</span>
        </p>

        <h1 class="font-serif text-5xl md:text-5xl lg:text-6xl text-cream leading-[1.05] tracking-tight mb-8">
          Customers don't meet your company. <span class="text-coral">They meet your product.</span>
        </h1>

        <p class="text-base leading-relaxed mb-4 max-w-md" style="color: #cfcae5;">
          We're the senior product and engineering team that builds it — end to end, in months not years.
        </p>

        <p class="text-base leading-relaxed mb-10 max-w-md" style="color: #a09cbe;">
          Behind Five Minute Journal (App of the Day, 60k MAU) and The Doctor's Kitchen (Apple Editorial, 4.8★).
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/book"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm bg-coral text-cream text-sm font-medium hover:bg-coral-deep transition-colors">
            Start with a Sprint →
          </a>
          <a href="mailto:workshop@allshapes.io?subject=Hello%20from%20startupasaservice.co"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm text-sm font-medium transition-colors"
            style="border: 1px solid #3d3870; color: #cfcae5;">
            Get in touch
          </a>
        </div>

        <p class="mt-10 text-sm leading-relaxed" style="color: #a09cbe;">
          Hosted by Thomas Horak — 15 years building startups,<br class="hidden md:block"/>
          and <a href="https://www.youtube.com/@ChangingShapesPodcast" target="_blank" rel="noopener noreferrer" class="text-cream hover:text-coral transition-colors underline-offset-2 hover:underline">a podcast full of the founders doing it now →</a>
        </p>
      </div>

      <!-- Right column placeholder so grid still flexes; the wall itself is positioned absolutely below -->
      <div class="hidden md:block"></div>
    </div>
  </div>

  <!-- Two vertical columns of square app icons, bleeding past the
       right edge of the viewport. Each column holds 5 tiles — both
       columns are taller than the hero section, so the top and bottom
       tiles get clipped naturally by the section's overflow-hidden. -->
  <div class="icon-wall hidden md:block absolute top-0 right-0 bottom-0 pointer-events-none z-10" style="width: 486px;" aria-hidden="true">
    <!-- The left edge of the wall is faded into the navy bg with an eased
         mask (see <style> below) so the tiles dissolve into the text column
         instead of ending on a hard edge. -->

    <!-- Two-column grid. Tiles are square, big, and stacked tall
         enough that the columns spill past the section bounds. -->
    <div class="absolute inset-0 grid grid-cols-2 gap-5 p-6 pt-0 pl-14">
      <div class="flex flex-col gap-5" style="transform: translateY(-90px);">
        {colA.map((app) => (
          <div class="relative rounded-2xl overflow-hidden shrink-0 shadow-lg"
            style="aspect-ratio: 1/1; background: #2B2660; border: 1px solid #3d3870;">
            <img src={app.icon} alt="" width="256" height="256" class="w-full h-full object-cover" loading="lazy" />
          </div>
        ))}
      </div>

      <div class="flex flex-col gap-5" style="transform: translateY(20px);">
        {colB.map((app) => (
          <div class="relative rounded-2xl overflow-hidden shrink-0 shadow-lg"
            style="aspect-ratio: 1/1; background: #2B2660; border: 1px solid #3d3870;">
            <img src={app.icon} alt="" width="256" height="256" class="w-full h-full object-cover" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Eased fade on the icon wall's left edge — a multi-stop mask (rather than
     a flat colour scrim) so the tiles melt into the navy with no banding and
     no hard seam where the wall meets the text column. */
  .icon-wall {
    -webkit-mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0.013) 6.5%,
      rgba(0, 0, 0, 0.049) 12.75%,
      rgba(0, 0, 0, 0.104) 18.75%,
      rgba(0, 0, 0, 0.175) 24.5%,
      rgba(0, 0, 0, 0.259) 30%,
      rgba(0, 0, 0, 0.352) 35.25%,
      rgba(0, 0, 0, 0.45) 40.25%,
      rgba(0, 0, 0, 0.55) 45%,
      rgba(0, 0, 0, 0.648) 49.5%,
      rgba(0, 0, 0, 0.741) 53.75%,
      rgba(0, 0, 0, 0.825) 57.75%,
      rgba(0, 0, 0, 0.896) 61.5%,
      rgba(0, 0, 0, 0.951) 65%,
      rgba(0, 0, 0, 0.987) 68.25%,
      rgba(0, 0, 0, 1) 72%
    );
    mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0.013) 6.5%,
      rgba(0, 0, 0, 0.049) 12.75%,
      rgba(0, 0, 0, 0.104) 18.75%,
      rgba(0, 0, 0, 0.175) 24.5%,
      rgba(0, 0, 0, 0.259) 30%,
      rgba(0, 0, 0, 0.352) 35.25%,
      rgba(0, 0, 0, 0.45) 40.25%,
      rgba(0, 0, 0, 0.55) 45%,
      rgba(0, 0, 0, 0.648) 49.5%,
      rgba(0, 0, 0, 0.741) 53.75%,
      rgba(0, 0, 0, 0.825) 57.75%,
      rgba(0, 0, 0, 0.896) 61.5%,
      rgba(0, 0, 0, 0.951) 65%,
      rgba(0, 0, 0, 0.987) 68.25%,
      rgba(0, 0, 0, 1) 72%
    );
  }
</style>
