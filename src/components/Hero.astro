---
import { APPS, FEATURED_INDEX } from '../data/apps';

// Re-shape the flat list into three columns so we can stagger each
// column's vertical offset independently. Five Minute Journal sits in
// the middle of column 2 — i.e. data index 4 maps to column 2 row 2.
const cols: typeof APPS[] = [[], [], []];
APPS.forEach((app, i) => { cols[i % 3].push(app); });
---

<section class="bg-navy-deep text-cream relative overflow-hidden">

  <!-- Subtle dot grid texture -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.035]"
    style="background-image: radial-gradient(#F2ECCA 1px, transparent 1px); background-size: 32px 32px;"
    aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[1180px] px-6 pt-32 pb-20 md:pt-40 md:pb-28">
    <div class="grid grid-cols-1 md:grid-cols-[1.05fr_1fr] gap-12 lg:gap-16 items-center">

      <!-- Left: copy -->
      <div class="relative z-10">

        <p class="text-xs uppercase tracking-[0.18em] mb-8" style="color: #cfcae5;">
          Startup as a Service · <span class="text-cream">by All Shapes</span>
        </p>

        <h1 class="font-serif text-5xl md:text-5xl lg:text-6xl text-cream leading-[1.05] tracking-tight mb-8">
          Customers don't meet your company. <span class="text-coral">They meet your product.</span>
        </h1>

        <p class="text-base leading-relaxed mb-4 max-w-md" style="color: #cfcae5;">
          We're the senior product and engineering team that builds it — end to end, in months not years.
        </p>

        <p class="text-base leading-relaxed mb-10 max-w-md" style="color: #a09cbe;">
          Behind Five Minute Journal (App of the Day, 60k MAU) and The Doctor's Kitchen (Apple Editorial, 4.8★).
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/book"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm bg-coral text-cream text-sm font-medium hover:bg-coral-deep transition-colors">
            Start with a Sprint →
          </a>
          <a href="mailto:workshop@allshapes.io?subject=Hello%20from%20startupasaservice.co"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm text-sm font-medium transition-colors"
            style="border: 1px solid #3d3870; color: #cfcae5;">
            Get in touch
          </a>
        </div>

        <p class="mt-10 text-sm leading-relaxed" style="color: #a09cbe;">
          Hosted by Thomas Horak — 15 years building startups,<br class="hidden md:block"/>
          and <a href="https://www.youtube.com/@ChangingShapesPodcast" target="_blank" rel="noopener noreferrer" class="text-cream hover:text-coral transition-colors underline-offset-2 hover:underline">a podcast full of the founders doing it now →</a>
        </p>
      </div>

      <!-- Right: 3-column staggered app grid. Columns drift vertically
           at different offsets so the wall reads as a magazine layout
           instead of a hard grid. The whole wall is masked at the edges
           so it fades into the navy — suggesting there are many more. -->
      <div class="app-wall relative" aria-label="Selected apps built by All Shapes">
        <div class="grid grid-cols-3 gap-3 md:gap-4 app-wall__inner">
          {cols.map((col, ci) => (
            <ul class={`app-col app-col--${ci}`} role="list">
              {col.map((app) => {
                const globalIndex = APPS.indexOf(app);
                const isFeatured = globalIndex === FEATURED_INDEX;
                return (
                  <li class={`app-tile ${isFeatured ? 'app-tile--featured' : ''}`}>
                    <a
                      href={app.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${app.name} — opens in a new tab`}
                      class="block relative overflow-hidden rounded-xl"
                      style="aspect-ratio: 1/1;"
                    >
                      <img
                        src={app.icon}
                        alt=""
                        class="app-icon absolute inset-0 w-full h-full object-cover"
                        loading={isFeatured ? "eager" : "lazy"}
                        onerror="this.style.display='none'; this.parentElement.querySelector('.app-fallback').style.display='flex';"
                      />
                      <div class="app-fallback absolute inset-0 hidden items-center justify-center p-2 text-center">
                        <span class="font-serif text-cream text-sm leading-tight">{app.name}</span>
                      </div>
                      <div class="app-name absolute inset-x-0 bottom-0 px-2 py-1.5 text-cream text-[11px] text-center font-medium"
                        style="background: linear-gradient(to top, rgba(31,27,74,0.96) 0%, rgba(31,27,74,0.6) 65%, transparent 100%);">
                        {app.name}
                      </div>
                    </a>
                  </li>
                );
              })}
            </ul>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ---- Layout ---- */

  .app-wall {
    /* Edge-fade mask. Black = visible, transparent = faded. A radial-ish
       composite that pulls the corners toward the navy background so it
       suggests there are more apps just beyond the frame. */
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, black 18%, black 82%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 14%, black 86%, transparent 100%);
    -webkit-mask-composite: source-in;
            mask-image:
      linear-gradient(to right, transparent 0%, black 18%, black 82%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 14%, black 86%, transparent 100%);
            mask-composite: intersect;
  }

  .app-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    .app-col { gap: 1rem; }
  }

  /* Stagger each column vertically — magazine-style wave */
  .app-col--0 { transform: translateY(0); }
  .app-col--1 { transform: translateY(-36px); }
  .app-col--2 { transform: translateY(12px); }

  /* ---- Tiles ---- */

  .app-tile a {
    /* Slightly lighter than the section background so the silhouettes
       sit on a softer field. */
    background: #2B2660;
    border: 1px solid #3d3870;
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
    will-change: transform, box-shadow;
  }
  .app-tile a:hover,
  .app-tile a:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -8px rgba(0, 0, 0, 0.5);
    border-color: #E34C39;
  }
  .app-tile a:focus-visible {
    outline: 2px solid #E34C39;
    outline-offset: 3px;
  }

  /* ---- Icon monochrome treatment ----
     Convert each App Store icon to a faded lavender silhouette that
     sits one shade lighter than the navy backdrop. We grayscale the
     image, lift its brightness, and reduce opacity. The cool blue tint
     of the underlying navy shows through. */
  .app-icon {
    filter:
      grayscale(100%)
      brightness(1.05)
      contrast(0.95)
      opacity(0.55);
    transition: filter 260ms ease, opacity 260ms ease;
    mix-blend-mode: lighten;
  }
  .app-tile a:hover .app-icon,
  .app-tile a:focus-visible .app-icon {
    filter:
      grayscale(20%)
      brightness(1.1)
      contrast(1)
      opacity(0.85);
  }

  /* Featured (Five Minute Journal) — brighter, with a soft coral ring
     so it stays the anchor of the wall. */
  .app-tile--featured a {
    box-shadow: 0 8px 24px -10px rgba(227, 76, 57, 0.55),
                0 0 0 1.5px rgba(227, 76, 57, 0.5);
    border-color: rgba(227, 76, 57, 0.4);
  }
  .app-tile--featured .app-icon {
    filter:
      grayscale(0%)
      brightness(1)
      opacity(0.9);
    mix-blend-mode: normal;
  }
  .app-tile--featured a:hover,
  .app-tile--featured a:focus-visible {
    box-shadow: 0 16px 36px -10px rgba(227, 76, 57, 0.75),
                0 0 0 2px rgba(227, 76, 57, 0.7);
  }
  .app-tile--featured a:hover .app-icon,
  .app-tile--featured a:focus-visible .app-icon {
    filter: grayscale(0%) brightness(1.05) opacity(1);
  }

  /* ---- Name overlay (hover/focus only) ---- */
  .app-name {
    opacity: 0;
    transition: opacity 220ms ease;
    pointer-events: none;
  }
  .app-tile a:hover .app-name,
  .app-tile a:focus-visible .app-name {
    opacity: 1;
  }

  /* ---- Mobile — tighten and re-centre ---- */
  @media (max-width: 640px) {
    .app-wall__inner { max-width: 340px; margin: 0 auto; }
    .app-col--0 { transform: translateY(0); }
    .app-col--1 { transform: translateY(-20px); }
    .app-col--2 { transform: translateY(8px); }
  }
</style>
