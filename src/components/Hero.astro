---
// Hero — brief §5 Home.Hero + STAAS_SITE_COPY.md §Home.Hero
---

<section class="relative overflow-hidden bg-cream">
  <!-- Decorative blobs -->
  <div
    class="pointer-events-none absolute -top-24 -right-32 w-[520px] h-[520px] rounded-full opacity-50"
    style="background: #F8DA8A; filter: blur(100px);"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute top-40 -left-24 w-[360px] h-[360px] rounded-full opacity-40"
    style="background: #F4C4DC; filter: blur(80px);"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-[1180px] px-6 pt-28 pb-0 md:pt-36">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-end">

      <!-- Left: copy -->
      <div class="pb-24 md:pb-32">
        <!-- Eyebrow -->
        <p class="text-xs font-medium tracking-widest uppercase text-coral mb-8">
          Startup as a Service
        </p>

        <!-- H1 -->
        <h1 class="font-serif text-6xl md:text-7xl lg:text-8xl text-navy leading-[1.0] tracking-tight mb-8">
          Experts have never been this
          <em class="not-italic text-coral"> affordable.</em>
        </h1>

        <!-- Subhead -->
        <p class="text-lg md:text-xl text-navy-muted max-w-md mb-3 leading-relaxed">
          The team you call to validate fast, then build to last.
        </p>

        <!-- Body line -->
        <p class="text-base text-navy-muted max-w-md mb-10 leading-relaxed">
          A senior product and engineering team, on subscription — for the build that comes after the demo.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="#pricing"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded bg-navy text-cream text-sm font-medium hover:bg-navy-deep transition-colors"
          >
            See pricing
          </a>
          <a
            href="/sprint"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded bg-coral text-cream text-sm font-medium hover:bg-coral-deep transition-colors"
          >
            Book the sprint
          </a>
        </div>
      </div>

      <!-- Right: image — hidden on mobile, visible md+ -->
      <div class="hidden md:block self-end">
        <div class="rounded-t overflow-hidden" style="height: 520px;">
          <img
            src="/hero-bg.jpg"
            alt="A senior team working on a product"
            class="w-full h-full object-cover object-top"
            loading="eager"
          />
        </div>
      </div>

    </div>
  </div>
</section>
