---
---

<section class="bg-navy-deep text-cream relative overflow-hidden">

  <!-- Subtle dot grid texture -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.035]"
    style="background-image: radial-gradient(#F2ECCA 1px, transparent 1px); background-size: 32px 32px;"
    aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[1180px] px-6 pt-32 pb-0 md:pt-40">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20 items-end">

      <!-- Left: copy -->
      <div class="pb-24 md:pb-32">
        <p class="font-mono text-xs text-coral mb-10 tracking-wider">// startup_as_a_service</p>

        <h1 class="font-serif text-6xl md:text-7xl lg:text-8xl text-cream leading-[1.0] tracking-tight mb-8">
          Senior product and engineering,<em class="not-italic text-coral"> without the hiring.</em>
        </h1>

        <p class="text-base md:text-lg leading-relaxed mb-10 max-w-md" style="color: #a09cbe;">
          A founding-level team on subscription. We validate your direction, build the product, and ship it — without equity, recruitment lag, or junior handoffs.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/sprint"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm bg-coral text-cream text-sm font-medium hover:bg-coral-deep transition-colors">
            Start with the Sprint →
          </a>
          <a href="#pricing"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm text-sm font-medium transition-colors"
            style="border: 1px solid #3d3870; color: #a09cbe;">
            See pricing
          </a>
        </div>
      </div>

      <!-- Right: work showcase — our real products -->
      <div class="hidden md:flex gap-3 self-end items-end pb-0">
        <!-- Tall left image -->
        <div class="flex-1 relative rounded overflow-hidden" style="aspect-ratio: 3/4;">
          <img
            src="/case-studies/five-minute-journal.jpg"
            alt="Five Minute Journal — App of the Day"
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 flex flex-col justify-end p-5"
            style="background: linear-gradient(to top, rgba(31,27,74,0.92) 0%, rgba(31,27,74,0.2) 60%, transparent 100%);">
            <p class="font-mono text-xs text-coral mb-1">App of the Day</p>
            <p class="text-cream text-sm font-medium leading-tight">Five Minute Journal</p>
            <p class="font-mono text-xs mt-1" style="color: #a09cbe;">60k MAU · 4.8★</p>
          </div>
        </div>
        <!-- Right column — two stacked images -->
        <div class="flex flex-col gap-3" style="flex: 0 0 48%;">
          <div class="relative rounded overflow-hidden" style="aspect-ratio: 4/3;">
            <img
              src="/case-studies/doctors-kitchen.jpg"
              alt="The Doctor's Kitchen"
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 flex flex-col justify-end p-4"
              style="background: linear-gradient(to top, rgba(31,27,74,0.92) 0%, transparent 60%);">
              <p class="font-mono text-xs text-coral mb-1">Apple Editorial</p>
              <p class="text-cream text-xs font-medium">Doctor's Kitchen</p>
            </div>
          </div>
          <div class="relative rounded overflow-hidden" style="aspect-ratio: 4/3;">
            <img
              src="/case-studies/allens-camera.jpg"
              alt="Allen's Camera"
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 flex flex-col justify-end p-4"
              style="background: linear-gradient(to top, rgba(31,27,74,0.92) 0%, transparent 60%);">
              <p class="font-mono text-xs text-coral mb-1">10× online revenue</p>
              <p class="text-cream text-xs font-medium">Allen's Camera</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
