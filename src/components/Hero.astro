---
import { APPS, FEATURED_INDEX, COL_LENGTHS } from '../data/apps';

// Slice the flat APPS list into three columns. The data is ordered to
// flow directly into 5 / 6 / 5 tiles.
const cols = [
  APPS.slice(0, COL_LENGTHS[0]),
  APPS.slice(COL_LENGTHS[0], COL_LENGTHS[0] + COL_LENGTHS[1]),
  APPS.slice(COL_LENGTHS[0] + COL_LENGTHS[1]),
];
---

<section class="bg-navy-deep text-cream relative overflow-hidden">

  <!-- Subtle dot grid texture -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.035]"
    style="background-image: radial-gradient(#F2ECCA 1px, transparent 1px); background-size: 32px 32px;"
    aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[1180px] px-6 pt-32 pb-20 md:pt-40 md:pb-28">
    <div class="grid grid-cols-1 md:grid-cols-[1.05fr_1fr] gap-12 lg:gap-16 items-center">

      <!-- Left: copy -->
      <div class="relative z-10">

        <p class="text-xs uppercase tracking-[0.18em] mb-8" style="color: #cfcae5;">
          Startup as a Service · <span class="text-cream">by All Shapes</span>
        </p>

        <h1 class="font-serif text-5xl md:text-5xl lg:text-6xl text-cream leading-[1.05] tracking-tight mb-8">
          Customers don't meet your company. <span class="text-coral">They meet your product.</span>
        </h1>

        <p class="text-base leading-relaxed mb-4 max-w-md" style="color: #cfcae5;">
          We're the senior product and engineering team that builds it — end to end, in months not years.
        </p>

        <p class="text-base leading-relaxed mb-10 max-w-md" style="color: #a09cbe;">
          Behind Five Minute Journal (App of the Day, 60k MAU) and The Doctor's Kitchen (Apple Editorial, 4.8★).
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/book"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm bg-coral text-cream text-sm font-medium hover:bg-coral-deep transition-colors">
            Start with a Sprint →
          </a>
          <a href="mailto:workshop@allshapes.io?subject=Hello%20from%20startupasaservice.co"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm text-sm font-medium transition-colors"
            style="border: 1px solid #3d3870; color: #cfcae5;">
            Get in touch
          </a>
        </div>

        <p class="mt-10 text-sm leading-relaxed" style="color: #a09cbe;">
          Hosted by Thomas Horak — 15 years building startups,<br class="hidden md:block"/>
          and <a href="https://www.youtube.com/@ChangingShapesPodcast" target="_blank" rel="noopener noreferrer" class="text-cream hover:text-coral transition-colors underline-offset-2 hover:underline">a podcast full of the founders doing it now →</a>
        </p>
      </div>

      <!-- Right: oversized tilted plane of app tiles. The plane is
           larger than its column AND vertically longer than the hero,
           so its corners bleed past the section's overflow-hidden box.
           Ghost (placeholder) tiles imply "many more" without faking
           specific apps. -->
      <div class="app-wall" aria-hidden="true">
        <div class="app-wall__plane">
          <div class="grid grid-cols-3 gap-3 md:gap-4 items-start">
            {cols.map((col, ci) => (
              <ul class={`app-col app-col--${ci}`} role="list">
                {col.map((app, i) => {
                  // Compute the global index so we can mark the
                  // featured FMJ tile from the flat APPS list.
                  let globalIndex = 0;
                  for (let k = 0; k < ci; k++) globalIndex += cols[k].length;
                  globalIndex += i;
                  const isFeatured = globalIndex === FEATURED_INDEX;
                  if (app.placeholder) {
                    return (
                      <li class="app-tile app-tile--ghost">
                        <div class="block relative overflow-hidden rounded-xl" style="aspect-ratio: 1/1;"></div>
                      </li>
                    );
                  }
                  return (
                    <li class={`app-tile ${isFeatured ? 'app-tile--featured' : ''}`}>
                      <div class="block relative overflow-hidden rounded-xl"
                        style="aspect-ratio: 1/1;">
                        <img
                          src={app.icon}
                          alt=""
                          class="app-icon absolute inset-0 w-full h-full object-cover"
                          loading={isFeatured ? "eager" : "lazy"}
                        />
                      </div>
                    </li>
                  );
                })}
              </ul>
            ))}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ---- Wedge plane ---- */

  .app-wall {
    position: relative;
    /* Local clipping — defensive; the parent section already clips. */
    overflow: visible;
    /* Constrain the plane's "anchor" to the column's height so the
       bottom rows fall off the section's natural bottom edge. */
    align-self: stretch;
    min-height: 100%;
  }

  .app-wall__plane {
    /* Bigger than the column AND tilted harder so the corners bleed
       past the section box. The section's overflow-hidden then makes
       a clean wedge cut. */
    transform: rotate(-9deg) translate(2%, -2%);
    transform-origin: 35% 40%;
    width: 124%;
    margin-left: -8%;
    /* Pull the top a bit so the upper ghost tiles bleed off the top
       edge as well as the right and bottom. */
    margin-top: -3rem;
  }

  /* ---- Columns ---- */

  .app-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    .app-col { gap: 1rem; }
  }

  /* Stagger each column vertically — magazine wave inside the tilted plane */
  .app-col--0 { transform: translateY(0); }
  .app-col--1 { transform: translateY(-44px); }
  .app-col--2 { transform: translateY(20px); }

  /* ---- Tiles ---- */

  .app-tile > div {
    background: #2B2660;
    border: 1px solid #3d3870;
    box-shadow: 0 12px 28px -14px rgba(0, 0, 0, 0.55);
  }

  .app-icon { display: block; }

  /* Ghosts — empty translucent tiles. Read as "and more, not shown." */
  .app-tile--ghost > div {
    background: rgba(43, 38, 96, 0.55);
    border: 1px dashed rgba(207, 202, 229, 0.18);
    box-shadow: none;
    /* Soft dot pattern hints at "icon goes here" without being literal */
    background-image: radial-gradient(rgba(242, 236, 202, 0.07) 1.5px, transparent 1.5px);
    background-size: 14px 14px;
    background-position: center;
    background-repeat: round;
  }

  /* Featured (Five Minute Journal) — coral ring anchors the centre. */
  .app-tile--featured > div {
    box-shadow: 0 10px 28px -10px rgba(227, 76, 57, 0.55),
                0 0 0 1.5px rgba(227, 76, 57, 0.5);
    border-color: rgba(227, 76, 57, 0.4);
  }

  /* ---- Mobile — drop the tilt + ghosts, show real tiles flat ---- */
  @media (max-width: 768px) {
    .app-wall__plane {
      transform: none;
      width: 100%;
      max-width: 360px;
      margin: 0 auto;
    }
    .app-col--0 { transform: translateY(0); }
    .app-col--1 { transform: translateY(-20px); }
    .app-col--2 { transform: translateY(8px); }
    /* Hide ghosts on small screens — they read as "missing" on mobile
       where the bleed effect doesn't sell. */
    .app-tile--ghost { display: none; }
  }
</style>
