---
// H16 — only the three high-impact projects (Five Minute Journal,
// Doctor's Kitchen, RNT Fitness). Each column shows two screenshots of
// the same product so the wall still feels rich without diluting the
// portfolio with weaker visuals.
const colA = [
  { src: "/case-studies/fmj-hero.jpg", label: "App of the Day", title: "Five Minute Journal" },
  { src: "/case-studies/tdk-aotd.jpg", label: "Apple Editorial", title: "Doctor's Kitchen" },
  { src: "/case-studies/rnt-hero.jpg", label: "Premium coaching SaaS", title: "RNT Fitness" },
  { src: "/case-studies/fmj-overview.jpg", label: "60k MAU · 4.8★", title: "Five Minute Journal" },
];

const colB = [
  { src: "/case-studies/tdk-overview.png", label: "Daily habit · subscription", title: "Doctor's Kitchen" },
  { src: "/case-studies/rnt-feed.png", label: "Multi-tenant SaaS", title: "RNT Fitness" },
  { src: "/case-studies/fmj-hero.jpg", label: "Habit-forming product", title: "Five Minute Journal" },
  { src: "/case-studies/rnt-profiles.jpg", label: "Cohort coaching", title: "RNT Fitness" },
];
---

<section class="bg-navy-deep text-cream relative overflow-hidden">

  <!-- Subtle dot grid texture -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.035]"
    style="background-image: radial-gradient(#F2ECCA 1px, transparent 1px); background-size: 32px 32px;"
    aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[1180px] px-6 pt-32 pb-0 md:pt-40">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20 items-end relative">

      <!-- Left: copy -->
      <div class="pb-24 md:pb-32 relative z-30">

        <p class="text-xs uppercase tracking-[0.18em] mb-8" style="color: #cfcae5;">
          Startup as a Service · <span class="text-cream">by All Shapes</span>
        </p>

        <h1 class="font-serif text-5xl md:text-5xl lg:text-6xl text-cream leading-[1.05] tracking-tight mb-8">
          Customers don't meet your company. <span class="text-coral">They meet your product.</span>
        </h1>

        <p class="text-base leading-relaxed mb-4 max-w-md" style="color: #cfcae5;">
          We're the senior product and engineering team that builds it — end to end, in months not years.
        </p>

        <p class="text-base leading-relaxed mb-10 max-w-md" style="color: #a09cbe;">
          Behind Five Minute Journal (App of the Day, 60k MAU) and The Doctor's Kitchen (Apple Editorial, 4.8★).
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/book"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm bg-coral text-cream text-sm font-medium hover:bg-coral-deep transition-colors">
            Start with a Sprint →
          </a>
          <a href="mailto:workshop@allshapes.io?subject=Hello%20from%20startupasaservice.co"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm text-sm font-medium transition-colors"
            style="border: 1px solid #3d3870; color: #cfcae5;">
            Get in touch
          </a>
        </div>

        <p class="mt-10 text-sm leading-relaxed" style="color: #a09cbe;">
          Hosted by Thomas Horak — 15 years building startups,<br class="hidden md:block"/>
          and <a href="https://www.youtube.com/@ChangingShapesPodcast" target="_blank" rel="noopener noreferrer" class="text-cream hover:text-coral transition-colors underline-offset-2 hover:underline">a podcast full of the founders doing it now →</a>
        </p>
      </div>

      <!-- Right column placeholder so grid still flexes; the wall itself is positioned absolutely below -->
      <div class="hidden md:block"></div>
    </div>
  </div>

  <!-- Bleeding wall of WIDE tiles — absolutely positioned, extends past the right viewport edge -->
  <div class="hidden md:block absolute top-0 right-0 bottom-0 pointer-events-none z-10" style="width: 58%;" aria-hidden="true">
    <!-- Fade left edge into the navy bg so the wall blends into the text column -->
    <div class="absolute inset-y-0 left-0 z-20 pointer-events-none"
      style="width: 260px; background: linear-gradient(to right, #1F1B4A 0%, rgba(31,27,74,0.95) 40%, rgba(31,27,74,0) 100%);"></div>
    <!-- Fade bottom edge into the next section -->
    <div class="absolute inset-x-0 bottom-0 z-20 pointer-events-none h-32"
      style="background: linear-gradient(to bottom, rgba(31,27,74,0) 0%, #1F1B4A 100%);"></div>

    <!-- Two columns of wide tiles. Aspect 16:10 ~ 1.6:1 — close enough to the
         source ratio (~2:1) that crops are minimal. -->
    <div class="absolute inset-0 grid grid-cols-2 gap-5 p-6 pt-24 pl-16">
      <div class="flex flex-col gap-5" style="transform: translateY(0);">
        {colA.map((t) => (
          <div class="relative rounded-md overflow-hidden shrink-0 shadow-lg" style="aspect-ratio: 16/10;">
            <img src={t.src} alt={t.title} class="w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 flex flex-col justify-end p-5"
              style="background: linear-gradient(to top, rgba(31,27,74,0.92) 0%, rgba(31,27,74,0.05) 55%, transparent 100%);">
              <p class="text-[11px] text-coral leading-tight uppercase tracking-[0.16em]">{t.label}</p>
              <p class="text-cream text-base font-medium leading-tight mt-1">{t.title}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="flex flex-col gap-5" style="transform: translateY(-80px);">
        {colB.map((t) => (
          <div class="relative rounded-md overflow-hidden shrink-0 shadow-lg" style="aspect-ratio: 16/10;">
            <img src={t.src} alt={t.title} class="w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 flex flex-col justify-end p-5"
              style="background: linear-gradient(to top, rgba(31,27,74,0.92) 0%, rgba(31,27,74,0.05) 55%, transparent 100%);">
              <p class="text-[11px] text-coral leading-tight uppercase tracking-[0.16em]">{t.label}</p>
              <p class="text-cream text-base font-medium leading-tight mt-1">{t.title}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
