---
// H16 — portfolio trimmed to the three high-impact projects. The
// generic capability tags below them give the ticker enough breadth.
const clients = [
  "Five Minute Journal",
  "The Doctor's Kitchen",
  "RNT Fitness",
  "iOS",
  "Android",
  "SaaS",
  "Consumer Apps",
  "Healthcare",
  "Fitness",
  "Nutrition",
  "Productivity",
  "Subscription",
];

// Duplicate for seamless loop
const doubled = [...clients, ...clients];
---

<div class="overflow-hidden border-y py-5" style="background: #1F1B4A; border-color: #3d3870;">
  <div class="ticker-track flex items-center gap-0 whitespace-nowrap" style="width: max-content;">
    {doubled.map((item, i) => (
      <span class="inline-flex items-center gap-8 px-8">
        <span class="text-xs tracking-[0.18em] uppercase" style="color: #cfcae5;">{item}</span>
        <span class="text-coral text-xs" aria-hidden="true">✦</span>
      </span>
    ))}
  </div>
</div>
