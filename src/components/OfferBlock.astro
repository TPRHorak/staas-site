---
// Deck Section 02 — EXPERTS / TASTE / EXPERIENCE / VALUES
const pillars = [
  {
    tag: "Experts",
    headline: "So it scales securely.",
    body: "A decade of building real products. Senior judgement at every line of code.",
  },
  {
    tag: "Taste",
    headline: "So it feels great.",
    body: "Apple App of the Day editorial. Design that turns users into evangelists.",
  },
  {
    tag: "Experience",
    headline: "Featured by Apple, repeatedly.",
    body: "Five Minute Journal, The Doctor’s Kitchen, RNT Fitness, MyGear Vault. A decade of consumer products that earn editorial.",
  },
  {
    tag: "Values",
    headline: "Software is a relationship.",
    body: "The product is the relationship between business and customer. We optimise for the user’s real life.",
  },
];
---

<section class="bg-cream py-24 md:py-[120px]">
  <div class="mx-auto max-w-[1180px] px-6">

    <!-- Eyebrow -->
    <p class="text-xs font-medium tracking-widest uppercase text-coral mb-8">
      Startup as a Service
    </p>

    <!-- Headline block -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8 mb-6">
      <h2 class="font-serif text-5xl md:text-6xl lg:text-7xl text-navy leading-[1.0] tracking-tight max-w-2xl">
        It’s never been this affordable to hire a senior team.
      </h2>
    </div>

    <!-- Why Startup -->
    <p class="text-base text-navy-muted max-w-xl mb-20 leading-relaxed border-l-2 border-coral pl-5">
      Why "Startup?" Teams who’ve built them know where to be fast and where to be detailed.
    </p>

    <!-- Four pillars -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-px rounded overflow-hidden" style="background: #d8d0a8;">
      {pillars.map((pillar) => (
        <div class="bg-cream p-8 md:p-12 flex flex-col gap-4">
          <span class="text-xs font-medium tracking-widest uppercase text-coral">{pillar.tag}</span>
          <h3 class="font-serif text-3xl md:text-4xl text-navy leading-tight">{pillar.headline}</h3>
          <p class="text-sm text-navy-muted leading-relaxed max-w-sm">{pillar.body}</p>
        </div>
      ))}
    </div>

    <!-- Closing line -->
    <p class="mt-16 font-serif text-3xl md:text-4xl text-navy-muted text-right">
      The team you’d hire if you could.
    </p>
  </div>
</section>
