---
const stats = [
  { number: "4.8★", label: "avg App Store rating" },
  { number: "25k+", label: "five-star reviews" },
  { number: "10yr", label: "longest partnership" },
  { number: "∞", label: "App of the Day features" },
];
---

<div class="bg-navy border-y border-navy-deep">
  <div class="mx-auto max-w-[1180px] px-6 py-10 md:py-14">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-0 md:divide-x" style="border-color: #3d3870;">
      {stats.map((s) => (
        <div class="flex flex-col items-center text-center md:px-8">
          <span class="font-serif text-4xl md:text-5xl text-coral mb-2">{s.number}</span>
          <span class="text-xs font-medium tracking-widest uppercase" style="color: #a09cbe;">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</div>
