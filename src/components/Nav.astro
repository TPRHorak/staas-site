---
const navLinks = [
  { label: "Compare", href: "/compare" },
  { label: "Work", href: "/work" },
  { label: "Notes", href: "/notes" },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-cream border-b border-cream-deep">
  <div class="mx-auto max-w-[1180px] px-6 flex items-center justify-between h-16">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 shrink-0">
      <img src="/logos/acs_logo_clean.png" alt="All Shapes" class="h-7 w-auto" />
    </a>

    <!-- Nav links -->
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "text-sm font-medium text-navy hover:text-coral transition-colors",
            { "text-coral": currentPath.startsWith(link.href) }
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- CTA -->
    <a
      href="/workshop"
      class="hidden md:inline-flex items-center px-4 py-2 rounded bg-coral text-cream text-sm font-medium hover:bg-coral-deep transition-colors"
    >
      Book the workshop
    </a>

    <!-- Mobile menu toggle (progressive enhancement — JS-free open/close via checkbox) -->
    <label for="mobile-menu-toggle" class="md:hidden cursor-pointer p-2" aria-label="Open menu">
      <span class="block w-5 h-0.5 bg-navy mb-1"></span>
      <span class="block w-5 h-0.5 bg-navy mb-1"></span>
      <span class="block w-5 h-0.5 bg-navy"></span>
    </label>
  </div>

  <!-- Mobile menu -->
  <input type="checkbox" id="mobile-menu-toggle" class="hidden peer" />
  <nav class="hidden peer-checked:flex flex-col gap-4 px-6 pb-6 md:hidden bg-cream border-t border-cream-deep">
    {navLinks.map((link) => (
      <a href={link.href} class="text-sm font-medium text-navy hover:text-coral transition-colors">
        {link.label}
      </a>
    ))}
    <a
      href="/workshop"
      class="inline-flex items-center justify-center px-4 py-2 rounded bg-coral text-cream text-sm font-medium hover:bg-coral-deep transition-colors"
    >
      Book the workshop
    </a>
  </nav>
</header>
