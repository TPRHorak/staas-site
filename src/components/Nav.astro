---
const navLinks = [
  { label: "Compare", href: "/compare" },
  { label: "Work", href: "/work" },
  { label: "Publications", href: "/publications" },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-cream border-b border-cream-deep">
  <div class="mx-auto max-w-[1180px] px-6 flex items-center justify-between h-20">
    <!-- Logo — H11 uses the abbreviated AS mark, lighter at nav scale -->
    <a href="/" class="flex items-center gap-3 shrink-0">
      <img src="/logos/acs_logo_clean.png" alt="All Shapes" width="190" height="180" class="h-10 md:h-11 w-auto" />
    </a>

    <!-- Nav links -->
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "text-sm font-medium text-navy hover:text-coral transition-colors",
            { "text-coral": currentPath.startsWith(link.href) }
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- CTA -->
    <a
      href="/book"
      class="hidden md:inline-flex items-center px-4 py-2 rounded bg-coral text-cream text-sm font-medium hover:bg-coral-deep transition-colors"
    >
      Book a Sprint
    </a>

    <!-- Mobile menu toggle -->
    <button
      type="button"
      id="mobile-menu-button"
      class="md:hidden p-2"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="block w-5 h-0.5 bg-navy mb-1" aria-hidden="true"></span>
      <span class="block w-5 h-0.5 bg-navy mb-1" aria-hidden="true"></span>
      <span class="block w-5 h-0.5 bg-navy" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    class="hidden md:hidden flex-col gap-4 px-6 pb-6 bg-cream border-t border-cream-deep"
  >
    {navLinks.map((link) => (
      <a href={link.href} class="text-sm font-medium text-navy hover:text-coral transition-colors">
        {link.label}
      </a>
    ))}
    <a
      href="/book"
      class="inline-flex items-center justify-center px-4 py-2 rounded bg-coral text-cream text-sm font-medium hover:bg-coral-deep transition-colors"
    >
      Book a Sprint
    </a>
  </nav>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;

    function setOpen(open) {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.classList.toggle('hidden', !open);
      menu.classList.toggle('flex', open);
    }

    btn.addEventListener('click', () => {
      setOpen(btn.getAttribute('aria-expanded') !== 'true');
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        btn.focus();
      }
    });
  })();
</script>
