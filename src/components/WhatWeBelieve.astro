---
const believes = [
  { title: "Judgement over speed.", body: "AI made code cheap. Senior taste got rare. We sell both." },
  { title: "Right-sizing.", body: "Build the cheapest thing that scales. Tell you what not to build." },
  { title: "The change in their life is the product.", body: "Real-life impact → customer success → retention → LTV. That order matters." },
  { title: "Same team, for years.", body: "Continuity is the product. Seniors who learn your business stay on it." },
  { title: "Published pricing. No equity.", body: "Rates on the website. Founder keeps the cap table." },
];

const wonts = [
  { title: "Discovery theatre.", body: "Quarter-long decks pretending to be planning." },
  { title: "Up-selling complexity.", body: "AI features when a database does the job." },
  { title: "Optimising for DAU.", body: "Vanity metrics that don't track the user's life getting better." },
  { title: "Rotating juniors.", body: "Senior pitches; juniors execute; you find out in month four." },
  { title: "Equity for execution.", body: "Venture studios that take 30% for \"the team.\"" },
];
---

<section class="py-24 md:py-[120px]" style="background: #2B2660;">
  <div class="mx-auto max-w-[1180px] px-6">

    <p class="font-mono text-xs text-coral mb-10 tracking-wider">// what_we_believe</p>

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-6">
      <h2 class="font-serif text-5xl md:text-6xl text-cream leading-tight tracking-tight max-w-lg">
        A short list. We mean every line.
      </h2>
      <p class="font-mono text-xs md:text-right shrink-0" style="color: #575280;">
        // Hire us if these match. Don't if they don't.
      </p>
    </div>

    <div class="mb-16 h-px" style="background: #3d3870;"></div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-px rounded overflow-hidden" style="background: #3d3870;">
      <div class="p-8 md:p-10 flex flex-col gap-0" style="background: #1F1B4A;">
        <p class="font-mono text-xs text-coral mb-8">// believe</p>
        {believes.map((item, i) => (
          <div class:list={["py-6", i < believes.length - 1 ? "border-b" : ""]} style="border-color: #3d3870;">
            <p class="font-serif text-lg text-cream mb-1">{item.title}</p>
            <p class="text-sm leading-relaxed" style="color: #a09cbe;">{item.body}</p>
          </div>
        ))}
      </div>
      <div class="p-8 md:p-10 flex flex-col gap-0" style="background: #2B2660;">
        <p class="font-mono text-xs text-coral mb-8">// won't_do</p>
        {wonts.map((item, i) => (
          <div class:list={["py-6", i < wonts.length - 1 ? "border-b" : ""]} style="border-color: #3d3870;">
            <p class="font-serif text-lg text-cream mb-1">{item.title}</p>
            <p class="text-sm leading-relaxed" style="color: #a09cbe;">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
