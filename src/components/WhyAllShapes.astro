---
// H3 — rotating word: "It made [WORD] products rare."
// Pause on hover, ~2.5s per swap, vertical slide with fade.
const rotatingWords = [
  "good",
  "secure",
  "intuitive",
  "scalable",
  "thoughtful",
  "efficient",
  "loved",
];
---

<section class="text-cream py-24 md:py-[120px]" style="background: #2B2660;">
  <div class="mx-auto max-w-[1180px] px-6">

    <p class="text-xs uppercase tracking-[0.18em] text-coral mb-6 md:mb-8">Why All Shapes</p>

    <h2 class="font-serif text-5xl md:text-6xl lg:text-7xl text-cream leading-[1.15] tracking-tight max-w-5xl mb-12">
      AI made building software cheap. It made
      <span class="word-rotator" data-words={JSON.stringify(rotatingWords)} aria-label="good, secure, intuitive, scalable, thoughtful, efficient, loved">
        <span class="word-rotator__current">good</span>
      </span>
      products rare.
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20 max-w-5xl">
      <p class="font-serif text-xl md:text-2xl leading-snug" style="color: #d8d2ee;">
        Demos are great for testing an idea fast — they show what a founder cares about. The next step is making it secure, usable, and ready to scale. That's a team game. A senior crew makes the difference between a working demo and a product people pay for, stay with, and tell their friends about.
      </p>
      <p class="font-serif text-xl md:text-2xl leading-snug" style="color: #d8d2ee;">
        We see your product the way you'd see your best barista: it's the part of your business the customer actually touches. So we don't just ship something bug-free — we make it <span class="text-cream">generous, thoughtful, and genuinely useful.</span> That's what makes people convert, stay, and tell other people about it.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-px rounded overflow-hidden" style="background: #3d3870;">
      <div class="p-8 md:p-10 flex flex-col gap-3" style="background: #1F1B4A;">
        <p class="text-xs uppercase tracking-widest text-coral">Experienced</p>
        <p class="font-serif text-2xl text-cream leading-snug">Senior all the way down.</p>
        <p class="text-sm leading-relaxed" style="color: #a09cbe;">10+ years building products that earn App of the Day, App Store editorial, and the kind of retention that keeps founders in business — with engineers carrying 20+ years on the team.</p>
      </div>
      <div class="p-8 md:p-10 flex flex-col gap-3" style="background: #1F1B4A;">
        <p class="text-xs uppercase tracking-widest text-coral">Fast</p>
        <p class="font-serif text-2xl text-cream leading-snug">Four months, not twelve.</p>
        <p class="text-sm leading-relaxed" style="color: #a09cbe;">AI gives us the throughput. Senior taste keeps it from going off the rails. Zero to one, fast, built to last.</p>
      </div>
      <div class="p-8 md:p-10 flex flex-col gap-3" style="background: #1F1B4A;">
        <p class="text-xs uppercase tracking-widest text-coral">Relational</p>
        <p class="font-serif text-2xl text-cream leading-snug">Built to be loved.</p>
        <p class="text-sm leading-relaxed" style="color: #a09cbe;">Subscription apps, daily-use tools, habit-forming products — that's our wheelhouse. We treat your user generously, and that's what makes them convert, stay subscribed, and tell other people about it.</p>
      </div>
    </div>

    <p class="mt-16 font-serif text-2xl md:text-3xl leading-snug max-w-3xl" style="color: #a09cbe;">
      Most products built in 2026 will be forgotten inside a year.{" "}
      <span class="text-cream">The ones that last had someone behind them who cared about the right things.</span>
    </p>
  </div>
</section>

<style>
  /* Coral parallelogram chip. Reserved width = longest word + padding
     ("thoughtful" ≈ 4.45em) so the box never resizes and the line never
     reflows when the word swaps. The box is skewed; the text is
     counter-skewed so it stays upright. */
  .word-rotator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 5.1em;
    padding: 0.06em 0.32em;
    margin: 0 0.06em;
    vertical-align: baseline;
    background: var(--color-coral);
    color: #fff;
    border-radius: 6px;
    transform: skewX(-9deg);
    overflow: hidden;
    white-space: nowrap;
  }
  .word-rotator__current {
    display: inline-block;
    transform: skewX(9deg);
    transition: opacity 220ms ease, transform 320ms cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity, transform;
  }
  .word-rotator.is-leaving .word-rotator__current {
    opacity: 0;
    transform: skewX(9deg) translateY(-0.55em);
  }
  .word-rotator.is-entering .word-rotator__current {
    opacity: 0;
    transform: skewX(9deg) translateY(0.55em);
  }
  @media (prefers-reduced-motion: reduce) {
    .word-rotator__current { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('.word-rotator').forEach((root) => {
      if (root.dataset.rotatorBound === '1') return;
      root.dataset.rotatorBound = '1';
      let words = [];
      try { words = JSON.parse(root.dataset.words || '[]'); } catch (_) {}
      if (!Array.isArray(words) || words.length < 2) return;
      const cur = root.querySelector('.word-rotator__current');
      if (!cur) return;

      let i = 0;
      let paused = false;
      root.addEventListener('mouseenter', () => { paused = true; });
      root.addEventListener('mouseleave', () => { paused = false; });

      function tick() {
        if (paused) return;
        if (reduceMotion) {
          i = (i + 1) % words.length;
          cur.textContent = words[i];
          return;
        }
        root.classList.add('is-leaving');
        setTimeout(() => {
          i = (i + 1) % words.length;
          cur.textContent = words[i];
          root.classList.remove('is-leaving');
          root.classList.add('is-entering');
          // double rAF so the browser commits the entering state before we remove it
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              root.classList.remove('is-entering');
            });
          });
        }, 280);
      }

      // Don't auto-cycle at all when the user prefers reduced motion —
      // leave the first word in place rather than looping content.
      if (!reduceMotion) setInterval(tick, 2500);
    });
  })();
</script>
