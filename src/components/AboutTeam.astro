---
const team = [
  {
    name: "Thomas Horak",
    role: "CEO & Co-Founder",
    since: "since 2015",
    avatar: "/team/thomas-avatar.jpg",
    bio: "15 years running product and engineering across consumer apps, SaaS, and ecommerce. Built All Shapes into the team behind some of the App Store's most recognised consumer products — Five Minute Journal, The Doctor's Kitchen, RNT Fitness. Thomas leads strategy, client relationships, and every meaningful product decision. He also hosts the Changing Shapes podcast — interviewing the founders building today.",
    focus: "Product strategy · Client relationships · Pricing and scope",
    contact: "thomas@allshapes.io",
    linkedin: "https://www.linkedin.com/in/thomas-horak/",
  },
  {
    name: "Callum McLennan",
    role: "Operations & Co-Founder",
    since: "since 2015",
    avatar: "/team/callum-avatar.jpg",
    bio: "Callum has run the operational side of All Shapes for a decade — how projects are scoped, staffed, and delivered, and how clients experience working with us. If a Sprint runs smoothly, that's Callum.",
    focus: "Operations · Delivery · Client experience",
    contact: null,
    linkedin: "https://www.linkedin.com/in/callummclennan/",
  },
  {
    name: "Jakub Heglas",
    role: "Lead Engineer",
    since: "engineering lead",
    avatar: "/team/jakub-avatar.jpg",
    bio: "Jakub leads engineering across All Shapes products — iOS, Android, web, and backend, from App-of-the-Day consumer apps to multi-tenant SaaS platforms serving thousands of users. Every architectural decision goes through Jakub. If there's a technical risk in your product, he'll find it.",
    focus: "Architecture · Multi-platform engineering · Technical review",
    contact: null,
    linkedin: "https://www.linkedin.com/in/jakub-heglas/",
  },
];
---

<section class="bg-cream py-24 md:py-[120px]">
  <div class="mx-auto max-w-[1180px] px-6">

    <p class="text-xs uppercase tracking-[0.18em] text-coral mb-6 md:mb-8">The Team</p>

    <h2 class="font-serif text-5xl md:text-6xl text-navy leading-tight tracking-tight max-w-xl mb-6">
      The people behind the product.
    </h2>
    <p class="text-base text-navy-muted max-w-lg mb-20 leading-relaxed">
      Founded by Thomas and Callum — a decade of building together. Jakub leads engineering. Every client. Every line of code. That's us.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-px rounded overflow-hidden" style="background: #d8d0a8;">
      {team.map((person) => (
        <div class="bg-cream p-8 md:p-12 flex flex-col gap-6">
          <!-- Header with hand-drawn avatar -->
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-4">
              <img
                src={person.avatar}
                alt={person.name}
                width="80"
                height="80"
                class="w-20 h-20 rounded-full object-cover shrink-0"
                style="background: #ECE4B8;"
                loading="lazy"
              />
              <div>
                <p class="font-serif text-2xl text-navy leading-tight">{person.name}</p>
                <p class="text-sm text-navy-muted mt-1">{person.role}</p>
              </div>
            </div>
            <span class="text-xs shrink-0 mt-1 uppercase tracking-wider" style="color: #b8b2d8;">{person.since}</span>
          </div>

          <!-- Bio -->
          <p class="text-sm text-navy-muted leading-relaxed border-t border-cream-deep pt-6">{person.bio}</p>

          <!-- Focus -->
          <div class="border-t border-cream-deep pt-6">
            <p class="text-xs uppercase tracking-widest text-coral mb-2">Focus</p>
            <p class="text-sm text-navy-muted">{person.focus}</p>
          </div>

          <div class="flex flex-col gap-2 mt-auto pt-2">
            {person.contact && (
              <a href={`mailto:${person.contact}`} class="text-sm text-coral hover:underline">
                {person.contact} →
              </a>
            )}
            {person.linkedin && (
              <a href={person.linkedin} target="_blank" rel="noopener noreferrer" class="text-sm text-navy-muted hover:text-coral transition-colors">
                LinkedIn →
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

    <p class="mt-8 text-sm" style="color: #8c87b0;">
      UK and Europe-based. We do not offshore. Every decision — that's us.
    </p>
  </div>
</section>
