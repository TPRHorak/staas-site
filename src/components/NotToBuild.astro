---
// Deck — "We tell you what not to build"
const examples = [
  {
    label: "Database before AI.",
    trigger: "Founder wants a generative-AI feature.",
    response: "We test the assumption first with a Postgres view and a saved-search UX. AI goes in only when the data tells us it'll move the metric.",
  },
  {
    label: "Email before app.",
    trigger: "Audience-led founder wants a mobile app.",
    response: "We ship a behavioural email sequence first. Build the app once email proves the funnel.",
  },
  {
    label: "Off-the-shelf before custom.",
    trigger: "Don't roll your own analytics, auth, or payments.",
    response: "We'll tell you which third-party service is good enough for your stage — and which one you'll outgrow.",
  },
];
---

<section class="bg-navy text-cream py-24 md:py-[120px]">
  <div class="mx-auto max-w-[1180px] px-6">
    <p class="text-xs font-medium tracking-widest uppercase mb-8" style="color: #a09cbe;">How we think</p>

    <h2 class="font-serif text-5xl md:text-6xl text-cream leading-tight tracking-tight max-w-2xl mb-6">
      We tell you what not to build.
    </h2>
    <p class="text-base mb-20 max-w-lg leading-relaxed" style="color: #a09cbe;">
      Most teams sell you the most complex thing they can. We sell you the simplest thing that still scales.
    </p>

    <!-- Examples -->
    <div class="flex flex-col gap-px rounded overflow-hidden" style="background: #3d3870;">
      {examples.map((ex) => (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 p-8 md:p-10 items-start" style="background: #2B2660;">
          <div>
            <p class="font-serif text-2xl text-coral">{ex.label}</p>
          </div>
          <div>
            <p class="text-xs font-medium tracking-widest uppercase mb-3" style="color: #a09cbe;">The ask</p>
            <p class="text-sm leading-relaxed" style="color: #a09cbe;">"{ex.trigger}"</p>
          </div>
          <div>
            <p class="text-xs font-medium tracking-widest uppercase mb-3 text-coral">Our call</p>
            <p class="text-sm text-cream leading-relaxed">{ex.response}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Macro / Micro -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8 border-t pt-16" style="border-color: #3d3870;">
      <div>
        <p class="font-serif text-3xl text-cream mb-3">Macro.</p>
        <p class="text-sm leading-relaxed" style="color: #a09cbe;">Which bet is worth taking. Which market position is defensible.</p>
      </div>
      <div>
        <p class="font-serif text-3xl text-cream mb-3">Micro.</p>
        <p class="text-sm leading-relaxed" style="color: #a09cbe;">Which library, which architecture, which trade-off this week.</p>
      </div>
    </div>
    <p class="mt-8 text-base" style="color: #a09cbe;">
      Both altitudes, every engagement.{" "}
      <span class="text-cream font-medium">Our incentive isn't to build the most expensive product. It's to build the one that works.</span>
    </p>
  </div>
</section>
