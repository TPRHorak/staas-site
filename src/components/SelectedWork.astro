---
// Brief §5 Home §9 — Move #6. Three case study cards, Significa pattern.
import WorkCard from './WorkCard.astro';

const works = [
  {
    title: "Five Minute Journal",
    slug: "five-minute-journal",
    hero: "/case-studies/five-minute-journal.jpg",
    oneLine: "The journal app for a daily gratitude practice. 60k MAU, 4.8★.",
    awards: ["App of the Day", "4.8★", "25k+ reviews", "60k MAU"],
  },
  {
    title: "The Doctor's Kitchen",
    slug: "doctors-kitchen",
    hero: "/case-studies/doctors-kitchen.jpg",
    oneLine: "Recipe + nutrition platform built around Dr Rupy's evidence-based food framework.",
    awards: ["App of the Day", "4.8★", "500+ recipes"],
  },
  {
    title: "RNT Fitness",
    slug: "rnt-fitness",
    hero: "/case-studies/rnt-fitness.jpg",
    oneLine: "Premium fitness education platform — multi-tenant, cohort-based, social learning.",
    awards: ["Multi-platform", "Multi-tenant from day one", "Cohort-driven SaaS"],
  },
];
---

<section class="bg-cream-deep py-24 md:py-[120px]">
  <div class="mx-auto max-w-[1180px] px-6">
    <!-- Eyebrow -->
    <p class="text-xs font-medium tracking-widest uppercase text-coral mb-6">
      Section 06 · Selected work
    </p>

    <!-- H2 -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-16">
      <h2 class="font-serif text-4xl md:text-5xl text-navy leading-tight tracking-tight max-w-lg">
        Apps people actually open.
      </h2>
      <a href="/work" class="text-sm font-medium text-coral hover:text-coral-deep transition-colors shrink-0">
        See all work →
      </a>
    </div>

    <!-- Three cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {works.map((work) => (
        <WorkCard {...work} />
      ))}
    </div>
  </div>
</section>
