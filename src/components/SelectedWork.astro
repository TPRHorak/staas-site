---
// Cards modelled on allshapes.io: 16:9 landscape, rounded, full-bleed
// image, gradient overlay, title-only — no metric chips or one-liner
// cluttering the read. The proof is the image.
const works = [
  {
    title: "Five Minute Journal",
    slug: "five-minute-journal",
    hero: "/case-studies/fmj-hero.jpg",
    eyebrow: "App of the Day · 60k MAU",
  },
  {
    title: "The Doctor's Kitchen",
    slug: "doctors-kitchen",
    hero: "/case-studies/tdk-aotd.jpg",
    eyebrow: "Apple Editorial · 4.8★",
  },
  {
    title: "RNT Fitness",
    slug: "rnt-fitness",
    hero: "/case-studies/rnt-hero.jpg",
    eyebrow: "Premium coaching SaaS",
  },
];
---

<section class="py-24 md:py-[120px]" style="background: #1F1B4A;">
  <div class="mx-auto max-w-[1180px] px-6">

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-16">
      <h2 class="font-serif text-5xl md:text-6xl lg:text-7xl text-cream leading-[1.15] tracking-tight max-w-2xl">
        Apps people actually open.
      </h2>
      <a href="/work" class="text-sm text-coral hover:underline shrink-0">
        See all work →
      </a>
    </div>

    <!-- 3-column grid on desktop, 1-column on mobile. Wider gap so each
         card breathes — no gap-px frame any more. -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {works.map((work) => (
        <a
          href={`/work/${work.slug}`}
          class="group block relative overflow-hidden rounded-xl"
          style="aspect-ratio: 16/10; background: #2B2660;"
        >
          <img
            src={work.hero}
            alt={work.title}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <!-- Bottom gradient + title only -->
          <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-7"
            style="background: linear-gradient(to top, rgba(31,27,74,0.96) 0%, rgba(31,27,74,0.55) 40%, rgba(31,27,74,0.05) 70%, transparent 100%);">
            <p class="text-xs uppercase tracking-widest text-coral mb-2">{work.eyebrow}</p>
            <h3 class="font-serif text-2xl md:text-3xl text-cream leading-[1.1]">{work.title}</h3>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
