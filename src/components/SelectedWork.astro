---
// allshapes.io card pattern: 16:10 landscape, rounded, full-bleed
// image, gradient overlay. Title + a single eyebrow line + a compact
// row of stats — that’s the proof, no other clutter.
const works = [
  {
    title: "Five Minute Journal",
    slug: "five-minute-journal",
    hero: "/case-studies/fmj-hero.jpg",
    eyebrow: "App of the Day",
    stats: ["60k MAU", "4.8★", "25k+ reviews"],
  },
  {
    title: "The Doctor’s Kitchen",
    slug: "doctors-kitchen",
    hero: "/case-studies/tdk-aotd.jpg",
    eyebrow: "Apple Editorial",
    stats: ["4.8★", "500+ recipes", "Subscription"],
  },
  {
    title: "RNT Fitness",
    slug: "rnt-fitness",
    hero: "/case-studies/rnt-hero.jpg",
    eyebrow: "Premium coaching SaaS",
    stats: ["Multi-platform", "Multi-tenant", "Cohort-driven"],
  },
];
---

<section class="bg-cream py-24 md:py-[120px]">
  <div class="mx-auto max-w-[1180px] px-6">

    <p class="text-xs uppercase tracking-[0.18em] text-coral mb-6 md:mb-8">Selected Work</p>

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-16">
      <h2 class="font-serif text-5xl md:text-6xl lg:text-7xl text-navy leading-[1.15] tracking-tight max-w-2xl">
        Apps people actually open.
      </h2>
      <a href="/work" class="text-sm text-coral hover:underline shrink-0">
        See all work <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {works.map((work) => (
        <a
          href={`/work/${work.slug}`}
          class="group flex flex-col overflow-hidden rounded-xl"
          style="background: #2B2660;"
        >
          <!-- Image -->
          <div class="overflow-hidden" style="aspect-ratio: 16/10;">
            <img
              src={work.hero}
              alt={work.title}
              width="1600"
              height="1000"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <!-- Text on solid card background, below the image -->
          <div class="flex flex-col p-6 md:p-7">
            <p class="text-xs uppercase tracking-[0.18em] text-coral mb-1.5">{work.eyebrow}</p>
            <h3 class="font-serif text-2xl md:text-3xl text-cream leading-[1.1] mb-3">{work.title}</h3>
            <div class="flex flex-wrap gap-1.5">
              {work.stats.map((s) => (
                <span class="text-[11px] px-2 py-0.5 rounded-full" style="background: rgba(242,236,202,0.12); color: #d8d2ee;">{s}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
