---
import BaseLayout from '../layouts/BaseLayout.astro';

const week1Steps = [
  { label: "Map", body: "goals, audience, friction" },
  { label: "Sketch", body: "individual solutions" },
  { label: "Decide", body: "pick the strongest, choose the path" },
  { label: "Prototype", body: "realistic build" },
  { label: "Test", body: "5 user interviews, founder in the room" },
];

const icps = [
  {
    title: "Creators with an audience.",
    body: "You own the audience. We bring the team. Newsletter, podcast, community, course. Building a product for the audience you already have.",
  },
  {
    title: "Founders without a CTO.",
    body: "Past prototype. Need real product. Pre-seed, seed, post-Lovable / Cursor / Claude Code. A working demo, no engineering org yet.",
  },
  {
    title: "Operators of existing products.",
    body: "Already shipping. Need senior judgement. Retention, conversion, App Store editorial. You need product taste plus build capacity.",
  },
];
---

<BaseLayout
  title="Book the Sprint — Startup as a Service"
  description="Two weeks. €6,250. One real outcome — picked together in Week 1."
>
  <!-- Hero -->
  <section class="bg-cream pt-28 pb-20 md:pt-36 md:pb-28">
    <div class="mx-auto max-w-[1180px] px-6">
      <p class="text-xs font-medium tracking-widest uppercase text-coral mb-6">The Sprint</p>
      <h1 class="font-serif text-5xl md:text-7xl text-navy leading-[1.02] tracking-tight max-w-2xl mb-6">
        The Sprint.
      </h1>
      <p class="text-2xl md:text-3xl text-navy max-w-2xl leading-snug mb-6">
        Two weeks. €6,250. <span class="text-coral">One real outcome — picked together in Week 1.</span>
      </p>
      <p class="text-base text-navy-muted max-w-2xl leading-relaxed mb-10">
        Two weeks isn't enough to ship a full product. It's enough to do one of two things properly: build one small feature in production, or validate one direction with a tested prototype and a buildable plan. We decide which on Day 3.
      </p>
      <a
        href="mailto:workshop@allshapes.io"
        class="inline-flex items-center justify-center px-8 py-4 rounded bg-coral text-cream text-sm font-medium hover:bg-coral-deep transition-colors"
      >
        Book it →
      </a>
    </div>
  </section>

  <!-- Week 1 -->
  <section class="bg-cream-deep py-20 md:py-28">
    <div class="mx-auto max-w-[1180px] px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">

        <!-- Label -->
        <div>
          <p class="text-xs font-medium tracking-widest uppercase text-coral mb-3">Week 1</p>
          <h2 class="font-serif text-4xl md:text-5xl text-navy leading-tight tracking-tight">
            Find the bet.
          </h2>
        </div>

        <!-- Steps -->
        <div class="flex flex-col gap-5">
          {week1Steps.map((step) => (
            <div class="flex items-baseline gap-3">
              <span class="shrink-0 text-sm font-medium text-coral w-20">{step.label}</span>
              <span class="text-sm text-navy-muted leading-relaxed">{step.body}</span>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- Week 2 — Two paths -->
  <section class="bg-cream py-20 md:py-28">
    <div class="mx-auto max-w-[1180px] px-6">
      <p class="text-xs font-medium tracking-widest uppercase text-coral mb-10">Week 2 — One of two paths</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Path A -->
        <div class="rounded border border-cream-deep overflow-hidden">
          <div class="bg-navy px-8 py-5">
            <p class="text-xs font-medium tracking-widest uppercase text-cream opacity-70 mb-1">Path A</p>
            <p class="text-base font-medium text-cream">Build one feature.</p>
          </div>
          <div class="px-8 py-8 flex flex-col gap-5">
            <p class="text-sm text-navy-muted leading-relaxed">For founders with a clear bet and a need for production code.</p>
            <div class="flex flex-col gap-4">
              <div>
                <p class="text-xs font-medium text-coral mb-1">Days 6–9</p>
                <p class="text-sm text-navy-muted leading-relaxed">Build one small, scoped feature in production. Real infrastructure, data, auth.</p>
              </div>
              <div>
                <p class="text-xs font-medium text-coral mb-1">Day 10</p>
                <p class="text-sm text-navy-muted leading-relaxed">Handoff. Live feature on a URL, strategy doc, subscription proposal.</p>
              </div>
            </div>
            <p class="text-sm font-medium text-navy border-t border-cream-deep pt-5">→ A working feature.</p>
          </div>
        </div>

        <!-- Path B -->
        <div class="rounded border border-cream-deep overflow-hidden">
          <div class="bg-navy px-8 py-5">
            <p class="text-xs font-medium tracking-widest uppercase text-cream opacity-70 mb-1">Path B</p>
            <p class="text-base font-medium text-cream">Prove the plan.</p>
          </div>
          <div class="px-8 py-8 flex flex-col gap-5">
            <p class="text-sm text-navy-muted leading-relaxed">For founders who need to validate the direction before committing to a build.</p>
            <div class="flex flex-col gap-4">
              <div>
                <p class="text-xs font-medium text-coral mb-1">Days 6–9</p>
                <p class="text-sm text-navy-muted leading-relaxed">Extend and polish the prototype. Run more user tests. Write the build plan.</p>
              </div>
              <div>
                <p class="text-xs font-medium text-coral mb-1">Day 10</p>
                <p class="text-sm text-navy-muted leading-relaxed">Handoff. Tested prototype, user research, written build plan, proposal.</p>
              </div>
            </div>
            <p class="text-sm font-medium text-navy border-t border-cream-deep pt-5">→ A tested prototype + a buildable plan anyone could execute.</p>
          </div>
        </div>

      </div>

      <!-- Always included -->
      <div class="mt-8 flex flex-wrap items-center gap-2 text-sm text-navy-muted">
        <span class="text-xs font-medium tracking-widest uppercase text-navy mr-2">Always</span>
        <span>Strategy doc</span>
        <span class="opacity-30">·</span>
        <span>User-test data (5+ interviews)</span>
        <span class="opacity-30">·</span>
        <span>Subscription proposal</span>
      </div>
    </div>
  </section>

  <!-- Pricing bar -->
  <section class="bg-navy py-10">
    <div class="mx-auto max-w-[1180px] px-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex flex-wrap items-center gap-6">
          <p class="text-cream font-medium text-lg">€6,250 fixed.</p>
          <p class="text-sm" style="color: #a09cbe;">Full credit toward month 1 if you sign within 14 days.</p>
        </div>
        <a
          href="mailto:workshop@allshapes.io"
          class="inline-flex items-center justify-center px-7 py-3.5 rounded bg-coral text-cream text-sm font-medium hover:bg-coral-deep transition-colors shrink-0"
        >
          Book the sprint →
        </a>
      </div>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="bg-cream-deep py-20 md:py-28">
    <div class="mx-auto max-w-[1180px] px-6">
      <h2 class="font-serif text-4xl md:text-5xl text-navy leading-tight tracking-tight max-w-lg mb-16">
        Who it's for.
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {icps.map((icp) => (
          <div class="border-t-2 pt-6" style="border-color: #2B2660;">
            <h3 class="font-sans font-medium text-base text-navy mb-3">{icp.title}</h3>
            <p class="text-sm text-navy-muted leading-relaxed">{icp.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Booking -->
  <section class="bg-cream py-20 md:py-28 text-center">
    <div class="mx-auto max-w-[1180px] px-6">
      <h2 class="font-serif text-4xl md:text-5xl text-navy leading-tight tracking-tight mb-4">
        Ready to start?
      </h2>
      <p class="text-base text-navy-muted max-w-md mx-auto mb-10 leading-relaxed">
        Email us and we'll reply within one business day. If we're not the right team for what you're building, we'll tell you who is.
      </p>
      <a
        href="mailto:workshop@allshapes.io"
        class="inline-flex items-center justify-center px-8 py-4 rounded bg-navy text-cream text-sm font-medium hover:bg-navy-deep transition-colors"
      >
        workshop@allshapes.io
      </a>
    </div>
  </section>
</BaseLayout>
