---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import AntiPositioning from '../components/AntiPositioning.astro';
import OfferBlock from '../components/OfferBlock.astro';
import MethodBlock from '../components/MethodBlock.astro';
import PricingTiers from '../components/PricingTiers.astro';
import RiskReversal from '../components/RiskReversal.astro';
import RelationalLens from '../components/RelationalLens.astro';
---

<BaseLayout
  title="Startup as a Service — Experts have never been this affordable"
  description="A senior product and engineering team, on subscription — for the build that comes after the demo."
>
  <Hero />
  <TrustStrip />
  <AntiPositioning />
  <OfferBlock />
  <MethodBlock />
  <PricingTiers />
  <RiskReversal />
  <RelationalLens />

  <!-- Testimonials, work, notes shelf, FAQ, Ask Claude, final CTA — Step 4 -->
  <div class="mx-auto max-w-[1180px] px-6 py-24 text-center">
    <p class="text-sm text-navy-muted italic">Testimonials, work, notes, FAQ and more — coming in Step 4.</p>
  </div>
</BaseLayout>
