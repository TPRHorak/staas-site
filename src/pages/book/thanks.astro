---
import BaseLayout from '../../layouts/BaseLayout.astro';

const calendlyUrl = "https://calendly.com/tom-allshapes/get-to-know-allshapes-io";
---

<BaseLayout
  title="Booked — pick your Day 0 slot"
  description="Pick a time for Day 0 — a short call to align before Day 1 begins."
>
  <!-- Header -->
  <section class="bg-navy-deep text-cream pt-32 pb-12 md:pt-40 md:pb-16">
    <div class="mx-auto max-w-[820px] px-6">
      <p class="font-mono text-xs tracking-wider mb-6 text-coral">// booked</p>
      <h1 class="font-serif text-5xl md:text-6xl text-cream leading-[1.05] tracking-tight mb-6">
        We've got it.<br/>
        <span style="color: #a09cbe;">Now pick a Day 0 slot.</span>
      </h1>
      <p class="text-lg leading-relaxed max-w-xl" style="color: #a09cbe;">
        You'll get a confirmation email shortly with your worksheet and the welcome pack. Below, grab a 30-minute slot with Thomas for Day 0 — a short call before Day 1 to align on what we're building.
      </p>
    </div>
  </section>

  <!-- Calendly embed -->
  <section class="bg-cream py-12">
    <div class="mx-auto max-w-[1080px] px-6">
      <div class="rounded overflow-hidden border" style="border-color: #d8d0a8;">
        <div
          class="calendly-inline-widget"
          data-url={`${calendlyUrl}?hide_gdpr_banner=1&background_color=f2ecca&text_color=1f1b4a&primary_color=e34c39`}
          style="min-width:320px;height:720px;"
        ></div>
      </div>

      <div class="mt-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <p class="text-sm text-navy-muted">
          Calendar not loading?
          <a href={calendlyUrl} target="_blank" rel="noopener noreferrer" class="text-coral hover:underline">Open Calendly →</a>
        </p>
        <p class="font-mono text-xs" style="color: #575280;">
          // Or email <a href="mailto:workshop@allshapes.io" class="text-coral hover:underline">workshop@allshapes.io</a>
        </p>
      </div>
    </div>
  </section>

  <!-- What's next -->
  <section class="py-16 md:py-24" style="background: #ECE4B8;">
    <div class="mx-auto max-w-[820px] px-6">
      <p class="font-mono text-xs tracking-wider text-coral mb-6">// what's_next</p>
      <h2 class="font-serif text-4xl md:text-5xl text-navy leading-tight tracking-tight mb-10 max-w-lg">
        How the next few days look.
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px rounded overflow-hidden" style="background: #d8d0a8;">
        <div class="bg-cream p-8 flex flex-col gap-3">
          <span class="font-mono text-xs text-coral">// today</span>
          <p class="font-serif text-xl text-navy">Confirmation lands.</p>
          <p class="text-sm text-navy-muted">An email with the welcome pack — the worksheet, NDA copy for your records, and a short list of what to share.</p>
        </div>
        <div class="bg-cream p-8 flex flex-col gap-3">
          <span class="font-mono text-xs text-coral">// before day 0</span>
          <p class="font-serif text-xl text-navy">We do our homework.</p>
          <p class="text-sm text-navy-muted">Tom reviews what you sent over so we don't waste the call on introductions.</p>
        </div>
        <div class="bg-cream p-8 flex flex-col gap-3">
          <span class="font-mono text-xs text-coral">// day 0</span>
          <p class="font-serif text-xl text-navy">Meet and greet.</p>
          <p class="text-sm text-navy-muted">30–45 minutes. We align on goals and confirm the path for Week 1. You meet the team.</p>
        </div>
        <div class="bg-cream p-8 flex flex-col gap-3">
          <span class="font-mono text-xs text-coral">// day 1</span>
          <p class="font-serif text-xl text-navy">Real work starts.</p>
          <p class="text-sm text-navy-muted">You're in a Slack channel with the senior team. Map, sketch, decide. No ramp-up.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Calendly widget loader -->
  <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
  <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async></script>
</BaseLayout>
