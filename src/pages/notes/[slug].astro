---
import { getCollection } from 'astro:content';

// Old per-note pages were replaced by the Substack-powered /notes index.
// We keep this route alive only to 301-redirect any old URL straight to
// Substack. The static notes content collection is still loaded so the
// build emits one HTML file per legacy slug (for SEO redirect coverage).

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.data.slug },
    props: { note },
  }));
}

const SUBSTACK_HOME = 'https://tomhorak.substack.com/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${SUBSTACK_HOME}`} />
    <link rel="canonical" href={SUBSTACK_HOME} />
    <title>Moved — read on Substack</title>
    <meta name="robots" content="noindex" />
    <style>
      body { font-family: ui-sans-serif, system-ui, sans-serif; background: #F2ECCA; color: #1F1B4A; }
      .wrap { max-width: 540px; margin: 8rem auto; padding: 0 1.5rem; text-align: center; }
      a { color: #E34C39; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <p>The notes now live on Substack.</p>
      <p>Taking you there…</p>
      <p><a href={SUBSTACK_HOME}>tomhorak.substack.com <span aria-hidden="true">→</span></a></p>
    </div>
  </body>
</html>
