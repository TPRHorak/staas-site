---
// /notes was renamed to /publications (H17). Anyone hitting an old
// shared /notes link gets bounced via meta-refresh.
const TARGET = '/publications';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${TARGET}`} />
    <link rel="canonical" href={TARGET} />
    <title>Moved — Publications</title>
    <meta name="robots" content="noindex" />
    <style>
      body { font-family: ui-sans-serif, system-ui, sans-serif; background: #F2ECCA; color: #1F1B4A; }
      .wrap { max-width: 540px; margin: 8rem auto; padding: 0 1.5rem; text-align: center; }
      a { color: #E34C39; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <p>Notes is now Publications.</p>
      <p>Taking you there…</p>
      <p><a href={TARGET}>Continue →</a></p>
    </div>
  </body>
</html>
