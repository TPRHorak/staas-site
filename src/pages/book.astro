---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SPRINTS, PRICE_PER_SPRINT, SPRINT_DURATION } from '../data/sprints';

// Group sprints by bucket so the form renders Design / Strategy / Build sections.
const byBucket = SPRINTS.reduce((acc, s) => {
  (acc[s.bucket] ||= []).push(s);
  return acc;
}, {} as Record<string, typeof SPRINTS>);
const buckets = ["Design", "Strategy", "Build"] as const;

// Import the NDA markdown content
import { marked } from 'marked';
import fs from 'node:fs';
import path from 'node:path';

const ndaPath = path.resolve('./src/content/legal/nda.md');
const ndaRaw = fs.readFileSync(ndaPath, 'utf8');
// Strip frontmatter
const ndaBody = ndaRaw.replace(/^---[\s\S]*?---\s*/m, '');
const ndaHtml = marked.parse(ndaBody);

// Build the absolute "thanks" URL from whichever origin we’re rendered on.
// Falls back to the production URL when Astro.url isn’t available at build time.
const origin = Astro.url?.origin || (Astro.site ? new URL(Astro.site).origin : 'https://staas.allshapes.io');
const nextUrl = `${origin}/book/thanks`;
---

<BaseLayout
  title="Book a Sprint — Startup as a Service"
  description="Start with a Sprint. Two weeks. €6,250. Pick what you need, sign the terms, and grab a Day 0 slot — in moments, not meetings."
>
  <!-- Page header -->
  <section class="bg-navy-deep text-cream pt-32 pb-12 md:pt-40 md:pb-16">
    <div class="mx-auto max-w-[820px] px-6">
      <h1 class="font-serif text-5xl md:text-6xl text-cream leading-[1.2] tracking-tight mb-6">
        Start with a Sprint.
      </h1>
      <p class="text-lg leading-relaxed max-w-xl" style="color: #a09cbe;">
        Four short steps. We’ve done the homework before we meet so Day 1 is real work. By the time you finish this form you’ll have a Day 0 call booked, the NDA accepted, and the team ready.
      </p>

      <!-- Progress -->
      <div class="mt-10 flex items-center gap-2 max-w-md" data-progress>
        <span class="h-1 flex-1 rounded-sm transition-colors" data-step-bar="1" style="background: #E34C39;"></span>
        <span class="h-1 flex-1 rounded-sm transition-colors" data-step-bar="2" style="background: #3d3870;"></span>
        <span class="h-1 flex-1 rounded-sm transition-colors" data-step-bar="3" style="background: #3d3870;"></span>
        <span class="h-1 flex-1 rounded-sm transition-colors" data-step-bar="4" style="background: #3d3870;"></span>
      </div>
      <p class="text-xs uppercase tracking-widest mt-3" style="color: #a09cbe;" aria-live="polite">
        Step <span data-step-current>1</span> of 4 · <span data-step-label>What do you need</span>
      </p>
    </div>
  </section>

  <!-- The form -->
  <section class="bg-cream py-16 md:py-24">
    <div class="mx-auto max-w-[820px] px-6">

      <!--
        Form backend: FormSubmit.co — zero signup. Submissions arrive as
        formatted email at workshop@allshapes.io. First submission triggers
        a one-time confirmation email; click the link to activate, then it
        works forever. No API keys, no servers.

        Hidden controls:
          _subject   — email subject line
          _next      — redirect URL after success
          _template  — readable table format for the email body
          _captcha   — disable FormSubmit’s reCAPTCHA (the honeypot below
                       handles bots)
          _honey     — FormSubmit’s built-in honeypot field
      -->
      <form
        name="staas-booking"
        method="POST"
        action="https://formsubmit.co/workshop@allshapes.io"
        class="flex flex-col gap-0"
      >
        <input type="hidden" name="_subject" value="New Sprint booking via staas-site" />
        <input type="hidden" name="_next" value={nextUrl} />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <p class="hidden" aria-hidden="true">
          <label>Don’t fill this out if you’re human: <input name="_honey" tabindex="-1" autocomplete="off" /></label>
        </p>

        <!-- STEP 1 — Pick a Sprint (H7) -->
        <fieldset data-step="1" class="border-0 p-0 m-0 flex flex-col gap-8">
          <div class="flex flex-col gap-3">
            <legend class="font-serif text-3xl md:text-4xl text-navy leading-[1.2]">
              Which Sprint fits your moment?
            </legend>
            <p class="text-base text-navy-muted leading-relaxed max-w-2xl">
              Five sprints. {SPRINT_DURATION} each. {PRICE_PER_SPRINT} flat. Pick the one closest to where you are — we’ll confirm on Day&nbsp;0 if a different one fits better.
            </p>
          </div>

          {buckets.map((bucket) => (
            <div class="flex flex-col gap-4">
              <p class="text-xs uppercase tracking-widest text-coral">{bucket}</p>
              {byBucket[bucket]?.map((s) => (
                <label class="flex gap-4 items-start p-6 rounded border cursor-pointer transition-colors hover:border-coral" style="border-color: #d8d0a8;">
                  <input type="radio" name="engagement" value={s.id} required class="mt-1.5 accent-coral" />
                  <span class="flex-1">
                    <span class="font-serif text-xl text-navy block leading-snug">{s.name}</span>
                    <span class="text-sm italic text-navy-muted block mt-1.5">“{s.anchor}”</span>
                    <ul class="mt-3 flex flex-col gap-1">
                      {s.alsoFor.map((line) => (
                        <li class="flex items-start gap-2 text-sm text-navy-muted leading-snug">
                          <span class="text-coral shrink-0">→</span>
                          {line}
                        </li>
                      ))}
                    </ul>
                  </span>
                </label>
              ))}
            </div>
          ))}

          <label class="flex gap-4 items-start p-6 rounded border cursor-pointer transition-colors hover:border-coral" style="border-color: #d8d0a8;">
            <input type="radio" name="engagement" value="not-sure" class="mt-1.5 accent-coral" />
            <span class="flex-1">
              <span class="font-serif text-xl text-navy block">Not sure yet — talk it through</span>
              <span class="text-sm text-navy-muted block mt-1">We’ll pick the right path on the Day 0 call.</span>
            </span>
          </label>

          <div class="flex justify-end mt-2">
            <button type="button" data-next="2" class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm bg-coral text-cream text-sm font-medium hover:bg-coral-deep transition-colors">
              Next <span aria-hidden="true">→</span>
            </button>
          </div>
        </fieldset>

        <!-- STEP 2 — About you -->
        <fieldset data-step="2" class="hidden border-0 p-0 m-0 flex-col gap-6">
          <legend class="font-serif text-3xl md:text-4xl text-navy leading-snug mb-2">
            Tell us about you.
          </legend>
          <p class="text-sm text-navy-muted -mt-4 mb-2">Enough so we can do our homework before Day 1.</p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <label class="flex flex-col gap-1.5">
              <span class="text-xs uppercase tracking-widest text-navy-muted">Your name</span>
              <input type="text" name="name" required autocomplete="name" placeholder="Jane Smith…"
                class="px-4 py-3 rounded border bg-cream-deep text-navy text-base focus:border-coral"
                style="border-color: #d8d0a8;" />
            </label>
            <label class="flex flex-col gap-1.5">
              <span class="text-xs uppercase tracking-widest text-navy-muted">Email</span>
              <input type="email" name="email" required autocomplete="email" inputmode="email"
                spellcheck="false" autocapitalize="off" autocorrect="off" placeholder="jane@company.com"
                class="px-4 py-3 rounded border bg-cream-deep text-navy text-base focus:border-coral"
                style="border-color: #d8d0a8;" />
            </label>
            <label class="flex flex-col gap-1.5">
              <span class="text-xs uppercase tracking-widest text-navy-muted">Company</span>
              <input type="text" name="company" required autocomplete="organization" placeholder="Acme Inc…"
                class="px-4 py-3 rounded border bg-cream-deep text-navy text-base focus:border-coral"
                style="border-color: #d8d0a8;" />
            </label>
            <label class="flex flex-col gap-1.5">
              <span class="text-xs uppercase tracking-widest text-navy-muted">Role</span>
              <input type="text" name="role" autocomplete="organization-title" placeholder="Founder, CEO, Head of Product…"
                class="px-4 py-3 rounded border bg-cream-deep text-navy text-base focus:border-coral"
                style="border-color: #d8d0a8;" />
            </label>
          </div>

          <label class="flex flex-col gap-1.5">
            <span class="text-xs uppercase tracking-widest text-navy-muted">What are you building (one or two lines)</span>
            <textarea name="product" required rows="3" placeholder="A subscription app for…"
              class="px-4 py-3 rounded border bg-cream-deep text-navy text-base focus:border-coral resize-y"
              style="border-color: #d8d0a8;"></textarea>
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-xs uppercase tracking-widest text-navy-muted">Where are you now</span>
            <select name="stage" required
              class="px-4 py-3 rounded border bg-cream-deep text-navy text-base focus:border-coral"
              style="border-color: #d8d0a8;">
              <option value="">Pick the closest one…</option>
              <option>Idea — nothing built yet</option>
              <option>Prototype — Lovable / Cursor / v0 / Figma</option>
              <option>Live product — already shipping</option>
              <option>Existing team — backlog we need cleared</option>
              <option>Other</option>
            </select>
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-xs uppercase tracking-widest text-navy-muted">Anything else we should know (optional)</span>
            <textarea name="notes" rows="3" placeholder="Codebase URL, deck link, audience size, timing…"
              class="px-4 py-3 rounded border bg-cream-deep text-navy text-base focus:border-coral resize-y"
              style="border-color: #d8d0a8;"></textarea>
          </label>

          <div class="flex justify-between gap-4 mt-4">
            <button type="button" data-prev="1" class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm text-sm font-medium transition-colors"
              style="border: 1px solid #d8d0a8; color: #575280;">
              ← Back
            </button>
            <button type="button" data-next="3" class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm bg-coral text-cream text-sm font-medium hover:bg-coral-deep transition-colors">
              Next <span aria-hidden="true">→</span>
            </button>
          </div>
        </fieldset>

        <!-- STEP 3 — Terms + NDA -->
        <fieldset data-step="3" class="hidden border-0 p-0 m-0 flex-col gap-6">
          <legend class="font-serif text-3xl md:text-4xl text-navy leading-snug mb-2">
            The paperwork.
          </legend>
          <p class="text-sm text-navy-muted -mt-4 mb-2">
            Standard mutual NDA so you can share a codebase or roadmap without worrying, plus our terms of service. Both available to read in full and download.
          </p>

          <!-- NDA expandable preview -->
          <details class="rounded border bg-cream-deep" style="border-color: #d8d0a8;">
            <summary class="cursor-pointer px-6 py-4 flex items-center justify-between text-sm font-medium text-navy list-none">
              <span class="flex items-center gap-3">
                <span class="text-xs uppercase tracking-widest text-coral">NDA</span>
                Mutual NDA (read in full)
              </span>
              <span class="text-xs text-navy-muted">expand ↓</span>
            </summary>
            <div class="prose-nda max-h-[420px] overflow-y-auto px-6 py-4 text-sm leading-relaxed text-navy-muted border-t" style="border-color: #d8d0a8;" set:html={ndaHtml}></div>
            <div class="px-6 py-3 border-t flex items-center justify-between text-xs" style="border-color: #d8d0a8; color: #575280;">
              <span>Horak Consulting GmbH · All Shapes</span>
              <a href="/legal/All-Shapes-NDA.docx" download class="text-coral hover:underline">Download .docx <span aria-hidden="true">→</span></a>
            </div>
          </details>

          <!-- Acceptance checkboxes -->
          <label class="flex items-start gap-3 p-4 rounded border cursor-pointer" style="border-color: #d8d0a8;">
            <input type="checkbox" name="accept_nda" value="yes" required class="mt-1 accent-coral" />
            <span class="text-sm text-navy leading-relaxed">
              I accept the mutual <strong>Non-Disclosure Agreement</strong> above on behalf of the company I represent, and confirm I’m authorised to do so.
            </span>
          </label>

          <label class="flex items-start gap-3 p-4 rounded border cursor-pointer" style="border-color: #d8d0a8;">
            <input type="checkbox" name="accept_terms" value="yes" required class="mt-1 accent-coral" />
            <span class="text-sm text-navy leading-relaxed">
              I agree to the All Shapes
              <a href="https://allshapes.io/terms-of-service" target="_blank" rel="noopener noreferrer" class="text-coral hover:underline">Terms of Service</a>.
            </span>
          </label>

          <div class="flex justify-between gap-4 mt-4">
            <button type="button" data-prev="2" class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm text-sm font-medium transition-colors"
              style="border: 1px solid #d8d0a8; color: #575280;">
              ← Back
            </button>
            <button type="button" data-next="4" class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm bg-coral text-cream text-sm font-medium hover:bg-coral-deep transition-colors">
              Next <span aria-hidden="true">→</span>
            </button>
          </div>
        </fieldset>

        <!-- STEP 4 — Review & submit -->
        <fieldset data-step="4" class="hidden border-0 p-0 m-0 flex-col gap-6">
          <legend class="font-serif text-3xl md:text-4xl text-navy leading-snug mb-2">
            One last look.
          </legend>
          <p class="text-sm text-navy-muted -mt-4 mb-2">
            We’ll send a confirmation to the email you gave us, plus a short welcome pack. Then you’ll land on the calendar to grab a Day 0 slot.
          </p>

          <div class="rounded border p-6 bg-cream-deep flex flex-col gap-3 text-sm" style="border-color: #d8d0a8;" data-review>
            <!-- filled in by JS -->
          </div>

          <p class="text-sm leading-relaxed" style="color: #8c87b0;">
            By submitting you confirm the information is accurate and that you’ve accepted the NDA and Terms above.
          </p>

          <div class="flex justify-between gap-4 mt-4">
            <button type="button" data-prev="3" class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm text-sm font-medium transition-colors"
              style="border: 1px solid #d8d0a8; color: #575280;">
              ← Back
            </button>
            <button type="submit" class="inline-flex items-center justify-center px-7 py-3.5 rounded-sm bg-coral text-cream text-sm font-medium hover:bg-coral-deep transition-colors">
              Submit & pick a Day 0 slot <span aria-hidden="true">→</span>
            </button>
          </div>
        </fieldset>

      </form>
    </div>
  </section>

  <!-- Trust footer -->
  <section class="py-12" style="background: #ECE4B8;">
    <div class="mx-auto max-w-[820px] px-6 flex flex-col md:flex-row gap-4 md:items-center md:justify-between">
      <p class="text-sm" style="color: #575280;">
        Scheduling ping-pong shouldn’t be the thing in your way.
      </p>
      <p class="text-sm text-navy-muted">
        Rather just chat first?
        <a href="mailto:workshop@allshapes.io" class="text-coral hover:underline">workshop@allshapes.io <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <script is:inline>
    (function () {
      const stepNames = {
        1: "What do you need",
        2: "About you",
        3: "Paperwork",
        4: "Review",
      };
      const fields = document.querySelectorAll('fieldset[data-step]');
      const bars = document.querySelectorAll('[data-step-bar]');
      const stepCurrent = document.querySelector('[data-step-current]');
      const stepLabel = document.querySelector('[data-step-label]');
      const review = document.querySelector('[data-review]');
      const form = document.querySelector('form[name="staas-booking"]');

      function stepFromUrl() {
        const raw = new URLSearchParams(window.location.search).get('step');
        const n = parseInt(raw, 10);
        return n >= 1 && n <= 4 ? n : 1;
      }

      function show(step, opts) {
        opts = opts || {};
        fields.forEach((f) => {
          const n = parseInt(f.dataset.step, 10);
          if (n === step) {
            f.classList.remove('hidden');
            f.classList.add('flex');
          } else {
            f.classList.add('hidden');
            f.classList.remove('flex');
          }
        });
        bars.forEach((b) => {
          const n = parseInt(b.dataset.stepBar, 10);
          b.style.background = n <= step ? '#E34C39' : '#3d3870';
        });
        if (stepCurrent) stepCurrent.textContent = String(step);
        if (stepLabel) stepLabel.textContent = stepNames[step] || '';
        if (step === 4) renderReview();

        // Reflect the step in the URL so refresh, share, and back/forward
        // all land on the right step instead of resetting to step 1.
        if (opts.history !== false) {
          const url = step === 1
            ? window.location.pathname
            : window.location.pathname + '?step=' + step;
          const state = { step };
          if (opts.push) history.pushState(state, '', url);
          else history.replaceState(state, '', url);
        }

        if (opts.scroll !== false) {
          const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: prefersReduced ? 'auto' : 'smooth' });
        }
      }

      function validateStep(step) {
        const fieldset = document.querySelector('fieldset[data-step="' + step + '"]');
        if (!fieldset) return true;
        const requiredEls = fieldset.querySelectorAll('[required]');
        for (const el of requiredEls) {
          if (!el.checkValidity()) {
            el.reportValidity();
            return false;
          }
        }
        return true;
      }

      function renderReview() {
        if (!form || !review) return;
        const fd = new FormData(form);
        const rows = [
          ['Engagement', fd.get('engagement')],
          ['Name', fd.get('name')],
          ['Email', fd.get('email')],
          ['Company', fd.get('company')],
          ['Role', fd.get('role') || '—'],
          ['Building', fd.get('product')],
          ['Stage', fd.get('stage')],
          ['Notes', fd.get('notes') || '—'],
          ['NDA accepted', fd.get('accept_nda') ? 'yes' : 'no'],
          ['Terms accepted', fd.get('accept_terms') ? 'yes' : 'no'],
        ];
        review.innerHTML = rows
          .map(
            ([k, v]) =>
              '<div class="flex gap-4"><span class="text-xs uppercase tracking-widest w-32 shrink-0 text-coral mt-0.5">' +
              k +
              '</span><span class="text-navy">' +
              String(v || '').replace(/</g, '&lt;') +
              '</span></div>'
          )
          .join('');
      }

      document.querySelectorAll('[data-next]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const current = parseInt(btn.closest('fieldset').dataset.step, 10);
          if (!validateStep(current)) return;
          show(parseInt(btn.dataset.next, 10), { push: true });
        });
      });
      document.querySelectorAll('[data-prev]').forEach((btn) => {
        btn.addEventListener('click', () => {
          show(parseInt(btn.dataset.prev, 10), { push: true });
        });
      });

      // Back/forward buttons move between steps; deep links open at the
      // right step. Never scrolls or rewrites history on these paths.
      window.addEventListener('popstate', () => show(stepFromUrl(), { history: false, scroll: false }));
      show(stepFromUrl(), { scroll: false });

      if (form) {
        let dirty = false;
        let submitting = false;
        form.addEventListener('input', () => { dirty = true; });

        form.addEventListener('submit', () => {
          // Patch FormSubmit’s _next to the current origin so previews
          // redirect to their own /book/thanks page rather than production.
          const nextField = form.querySelector('input[name="_next"]');
          if (nextField) nextField.value = window.location.origin + '/book/thanks';

          // Prevent double-submit: disable the button and show progress.
          submitting = true;
          dirty = false;
          const submitBtn = form.querySelector('button[type="submit"]');
          if (submitBtn) {
            submitBtn.setAttribute('aria-busy', 'true');
            submitBtn.textContent = 'Sending…';
            // Disable after the submit is captured so field data still posts.
            setTimeout(() => { submitBtn.disabled = true; }, 0);
          }
        });

        // Warn before leaving mid-way with unsaved input.
        window.addEventListener('beforeunload', (e) => {
          if (dirty && !submitting) { e.preventDefault(); e.returnValue = ''; }
        });
      }
    })();
  </script>

  <style>
    .prose-nda h2 { font-size: 1.05rem; font-weight: 600; color: #2B2660; margin: 1.4rem 0 0.4rem; }
    .prose-nda p { margin: 0.6rem 0; }
    .prose-nda ul { list-style: disc; padding-left: 1.25rem; margin: 0.4rem 0; }
    .prose-nda li { margin: 0.25rem 0; }
    .prose-nda strong { color: #2B2660; }
    .prose-nda hr { border: 0; border-top: 1px solid #d8d0a8; margin: 1.5rem 0; }
  </style>
</BaseLayout>
