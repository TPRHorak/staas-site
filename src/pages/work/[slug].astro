---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const works = await getCollection('work');
  return works.map((work) => ({
    params: { slug: work.data.slug },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);
---

<BaseLayout
  title={`${work.data.title} — Startup as a Service`}
  description={work.data.oneLine}
>
  <!-- Hero image -->
  <div class="w-full bg-cream-deep aspect-[16/7] overflow-hidden">
    <img
      src={work.data.hero}
      alt={work.data.title}
      class="w-full h-full object-cover"
      onerror="this.parentElement.style.background='#ECE4B8'"
    />
  </div>

  <!-- Header -->
  <section class="bg-cream pt-12 pb-12 md:pb-16">
    <div class="mx-auto max-w-[1180px] px-6">
      <a href="/work" class="text-xs font-medium tracking-widest uppercase text-coral hover:text-coral-deep transition-colors mb-8 inline-block">
        ← Work
      </a>
      <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-8">
        <div>
          <h1 class="font-serif text-4xl md:text-5xl text-navy leading-tight tracking-tight mb-3">
            {work.data.title}
          </h1>
          <p class="text-base text-navy-muted">{work.data.oneLine}</p>
        </div>
        <div class="shrink-0 flex flex-wrap gap-2 md:justify-end self-end">
          {work.data.awards.map((award) => (
            <span class="text-xs px-2 py-1 bg-yellow-soft text-navy rounded font-medium">{award}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Body -->
  <section class="bg-cream pb-24 md:pb-32">
    <div class="mx-auto max-w-[720px] px-6">
      <div class="prose prose-navy max-w-none
        prose-headings:font-sans prose-headings:font-medium prose-headings:text-navy
        prose-p:text-navy-muted prose-p:leading-relaxed prose-p:text-base
        prose-strong:text-navy prose-strong:font-medium
        prose-li:text-navy-muted prose-li:text-base
        prose-a:text-coral prose-a:no-underline hover:prose-a:underline
      ">
        <Content />
      </div>
    </div>
  </section>

  <!-- Footer CTA -->
  <section class="bg-navy py-20 text-center">
    <div class="mx-auto max-w-[1180px] px-6">
      <p class="font-serif text-3xl text-cream mb-8">Ready to build yours?</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/sprint" class="inline-flex items-center justify-center px-8 py-4 rounded bg-coral text-cream text-sm font-medium hover:bg-coral-deep transition-colors">
          Book a Sprint
        </a>
        <a href="/work" class="text-sm text-cream opacity-60 hover:opacity-100 transition-opacity">
          ← Back to all work
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
