---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getCollection } from 'astro:content';

// The public portfolio: projects with a usable hero (a real product shot
// or a clean brand/app icon). Wide product shots lead; icon-tile cards
// follow. Any other case study still has a live /work/<slug> page but is
// kept off the index until it has an asset that earns its place.
const ALLOWED = new Set([
  'five-minute-journal',
  'doctors-kitchen',
  'rnt-fitness',
  'allens-camera',
  'sales-made-simple',
  'mygear-vault',
  'food-medic',
  'lets-get-closer',
  'mindful-daily-affirmations',
  'fuggerei',
  'beproductive',
]);
const allWork = await getCollection('work');
const works = allWork
  .filter((w) => ALLOWED.has(w.data.slug))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Selected work — Startup as a Service"
  description="Products people actually open. Creator apps, SaaS platforms, and ecommerce — built with senior taste."
>
  <!-- Header -->
  <section class="bg-cream pt-28 pb-16 md:pt-36 md:pb-20">
    <div class="mx-auto max-w-[1180px] px-6">
      <p class="text-xs font-medium tracking-widest uppercase text-coral mb-6">Selected work</p>
      <h1 class="font-serif text-5xl md:text-7xl text-navy leading-tight tracking-tight max-w-2xl mb-6">
        Apps people actually open.
      </h1>
      <p class="text-xl text-navy-muted max-w-xl leading-relaxed">
        Creator apps, SaaS platforms, ecommerce — built with senior taste and shipped to real users.
      </p>
    </div>
  </section>

  <!-- Work grid -->
  <section class="bg-cream-deep py-16 md:py-24">
    <div class="mx-auto max-w-[1180px] px-6">
      <h2 class="sr-only">Case studies</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {works.map((work) => (
          <WorkCard
            title={work.data.title}
            slug={work.data.slug}
            hero={work.data.hero}
            oneLine={work.data.oneLine}
            awards={work.data.awards}
            external={work.data.external}
            iconOnly={work.data.iconOnly}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
